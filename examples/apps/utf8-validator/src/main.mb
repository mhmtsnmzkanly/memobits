// Check strict UTF-8 validation over the logical prefix of fixed byte arrays.
fn count_is(bytes: Array<u8, 8>, length: i32, expected: i32) -> Bool {
    match bytes.validate_utf8(length) {
        Ok(count) => count == expected,
        Err(_) => false,
    }
}

fn error_is(bytes: Array<u8, 8>, length: i32, code: u32, expected: Option<i32>) -> Bool {
    match bytes.validate_utf8(length) {
        Ok(_) => false,
        Err(error) => {
            let Utf8Error { code: actual_code, offset } := error;
            if actual_code != code { return false; }
            match offset {
                Some(position) => match expected {
                    Some(wanted) => position == wanted,
                    None => false,
                },
                None => match expected { None => true, Some(_) => false },
            }
        },
    }
}

fn main() -> Result<i32, Error> {
    // é, NUL and ASCII DEL. The invalid byte after the logical end is padding.
    if !count_is([195, 169, 0, 127, 255, 0, 0, 0], 4, 3)
        || !count_is([255; 8], 0, 0) {
        return Err(Error { code: 1 });
    }
    // Valid boundaries: U+0080/U+07FF, U+0800/U+D7FF, U+E000/U+FFFF,
    // and U+10000/U+10FFFF. Noncharacters are still Unicode scalar values.
    if !count_is([194, 128, 223, 191, 0, 0, 0, 0], 4, 2)
        || !count_is([224, 160, 128, 237, 159, 191, 0, 0], 6, 2)
        || !count_is([238, 128, 128, 239, 191, 191, 0, 0], 6, 2)
        || !count_is([240, 144, 128, 128, 244, 143, 191, 191], 8, 2) {
        return Err(Error { code: 2 });
    }
    // Truncation reports the first missing byte, even if the buffer holds it.
    if !error_is([195, 169, 0, 0, 0, 0, 0, 0], 1, 3, Some(1))
        || !error_is([65, 240, 144, 128, 128, 0, 0, 0], 4, 3, Some(4))
        || !error_is([226, 130, 172, 0, 0, 0, 0, 0], 2, 3, Some(2)) {
        return Err(Error { code: 3 });
    }
    // A present invalid continuation is reported before any missing byte.
    if !error_is([65, 226, 65, 0, 0, 0, 0, 0], 3, 4, Some(2))
        || !error_is([240, 144, 128, 192, 0, 0, 0, 0], 4, 4, Some(3))
        || !error_is([195, 65, 0, 0, 0, 0, 0, 0], 2, 4, Some(1)) {
        return Err(Error { code: 4 });
    }
    // Stray continuation, two-byte overlong lead, and leads above F4.
    if !error_is([65, 128, 0, 0, 0, 0, 0, 0], 2, 2, Some(1))
        || !error_is([192, 175, 0, 0, 0, 0, 0, 0], 2, 2, Some(0))
        || !error_is([245, 128, 128, 128, 0, 0, 0, 0], 4, 2, Some(0))
        || !error_is([255; 8], 8, 2, Some(0)) {
        return Err(Error { code: 5 });
    }
    // A disallowed second byte makes the sequence invalid at byte 1.
    if !error_is([224, 159, 191, 0, 0, 0, 0, 0], 3, 4, Some(1))
        || !error_is([237, 160, 128, 0, 0, 0, 0, 0], 3, 4, Some(1))
        || !error_is([240, 143, 191, 191, 0, 0, 0, 0], 4, 4, Some(1))
        || !error_is([244, 144, 128, 128, 0, 0, 0, 0], 4, 4, Some(1)) {
        return Err(Error { code: 6 });
    }
    if !error_is([0; 8], -1, 1, None) || !error_is([0; 8], 9, 1, None) {
        return Err(Error { code: 7 });
    }
    let short: Array<u8, 2> = [195, 169];
    let inferred_size := match short.borrow().validate_utf8(2) {
        Ok(count) => count == 1,
        Err(_) => false
    };
    if !inferred_size { return Err(Error { code: 8 }); }
    Ok(0)
}
