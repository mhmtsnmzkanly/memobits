use self::grid::Grid;
use self::grid::shortest_cost;

// Start and goal sit on opposite sides of a wall with one gap.
// S.#.G
// ..#..
// ..#..
// ..#..
// .....
fn walled_grid() -> Grid {
    [
        [false, false, true, false, false],
        [false, false, true, false, false],
        [false, false, true, false, false],
        [false, false, true, false, false],
        [false, false, false, false, false],
    ]
}

// Cost of the shortest path through the gap, or an Err when no path exists.
fn main() -> i32 ! Error {
    let grid: Grid = walled_grid();
    match shortest_cost(grid.borrow(), 0, 0, 4, 0) {
        Some(steps) => Ok(steps),
        None => Err(Error { code: 1 }),
    }
}

// Every route must walk down four rows, cross four columns, and
// climb four rows. A path along the perimeter attains that bound.
test fn shortest_path_goes_through_the_gap() {
    let grid: Grid = walled_grid();
    match shortest_cost(grid.borrow(), 0, 0, 4, 0) {
        Some(steps) => assert(steps == 12),
        None => assert(false),
    }
}

// Close the gap. The goal is still open, but the frontier must run out.
test fn closed_gap_leaves_no_path() {
    var grid: Grid = walled_grid();
    grid[4][2] = true;
    match shortest_cost(grid.borrow(), 0, 0, 4, 0) {
        Some(_) => assert(false),
        None => assert(true),
    }
}
