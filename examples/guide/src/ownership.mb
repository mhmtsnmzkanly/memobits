use text::{byte_is, byte_length};
use collections::make_words;
use alloc::List;

// drop consumes a whole named owned String, List<u8>, or List<u32>.
// A mutable binding can be assigned again. A loan must end before drop.
// A user binding or function named drop takes precedence.
test fn explicit_drop() {
    let text := "release".concat(" me");
    var bytes: List<u8> = [];
    bytes.push(42);
    let words := make_words(1000);
    drop(text);
    drop(bytes);
    drop(words);
    bytes = [];
    bytes.push(7);
    assert(bytes.len() == 1);
    assert(bytes.contains(7));
}
type TextLabel {
    number: u32,
    text: string,
}
// A local struct can own a literal-backed String alongside primitive fields.
// Read the field by borrowing it and move the whole struct to transfer it.
// Scope exit needs no deallocation. The frame is reclaimed on return, and
// literal bytes live in static memory.
// Use straight-line literal field initializers.
test fn local_string_fields() {
    var label := TextLabel { text: "é", number: 42 };
    {
        let moved := label;
        assert(byte_is(moved.text.byte_at(0), 195));
        assert(moved.number == 42);
        assert(byte_length(moved.text.borrow()) == 2);
    };
    label = TextLabel { number: 7, text: "" };
    assert(label.number == 7);
    assert(label.text.len() == 0);
}
// Move a named heap String into a new local struct, then move the whole
// struct into another local. The final owner releases the String at scope exit.
// Borrow the field to read it. Wasm gates temporary String initializers,
// escaping or replacing a whole heap-owning struct, nesting, and returning
// the struct. A flat struct can be passed and returned by value; see
// `owned_string_struct_argument`.
test fn local_heap_string_fields() {
    let text := "é".concat("!");
    let label := TextLabel { number: 9, text: text };
    {
        let moved := label;
        assert(moved.number == 9);
        assert(moved.text.len() == 3);
        assert(byte_is(moved.text.byte_at(2), 33));
    }
}
// A flat struct whose fields are Strings and primitives moves into an owned
// internal parameter from a named local. The callee owns it and releases the
// String at its exit, on an early return too. The caller cannot use the moved
// local afterwards. A function can also return such a struct by moving a named
// local; the call result can be bound to a new local (`let label := make_label();`)
// or used directly (see `call_results_in_every_value_position`).
// Such a struct can also be a tuple element or a fixed-array element when it
// moves in from a named local (see `string_struct_elements`), a field of another
// String-owning struct, or an enum payload (see `nested_string_owners`).
// A struct literal or call result can be passed directly to an owned parameter
// (see `owner_temporaries_as_arguments`). `[l; N]` repeats, recursive
// by-value types, exported signatures, and moving a field, element or payload
// out of a live owner stay rejected.
fn label_total(label: TextLabel, early: bool) -> u32 {
    if early { return 1; }
    label.number + label.text.len()
}
fn make_label(number: u32) -> TextLabel {
    let heap := "é".concat("!");
    let label := TextLabel { number: number, text: heap };
    label
}
test fn owned_string_struct_argument() {
    let heap := "é".concat("!");
    let first := TextLabel { number: 9, text: heap };
    let second := TextLabel { number: 5, text: "ab" };
    let spare_heap := "é".concat("!");
    let spare := TextLabel { number: 0, text: spare_heap };
    assert(label_total(first, false) == 12);
    assert(label_total(second, false) == 7);
    assert(label_total(spare, true) == 1);
}
fn label_pair_total(labels: array<TextLabel, 2>, early: bool) -> u32 {
    if early { return 1; }
    label_total_borrowed(labels[0].borrow()) + label_total_borrowed(labels[1].borrow())
}
fn label_total_borrowed(label: borrow TextLabel) -> u32 {
    label.number + label.text.len()
}
fn label_row_total(row: borrow (TextLabel, u32)) -> u32 {
    row.0.number + row.0.text.len() + row.1
}
// Elements are read through a borrow of the element or of the whole tuple.
// Scope exit releases the Strings, and the array moves into an owned call.
test fn string_struct_elements() {
    let first_heap := "é".concat("!");
    let first := TextLabel { number: 9, text: first_heap };
    let second := TextLabel { number: 5, text: "ab" };
    let pair := [first, second];
    let direct := label_total_borrowed(pair[0].borrow());
    let row_heap := "é".concat("!");
    let row_label := TextLabel { number: 1, text: row_heap };
    let row: (TextLabel, u32) = (row_label, 2);
    let spare_heap := "é".concat("!");
    let spare_first := TextLabel { number: 0, text: spare_heap };
    let spare_second := TextLabel { number: 0, text: "" };
    let spare := [spare_first, spare_second];
    assert(direct == 12);
    assert(label_row_total(row.borrow()) == 6);
    assert(label_pair_total(pair, false) == 19);
    assert(label_pair_total(spare, true) == 1);
}
type NestedLabel {
    label: TextLabel,
    extra: u32,
}
type LabelSlot [Empty, Holds(NestedLabel), Rows(array<TextLabel, 2>)]
fn nested_label_total(nested: NestedLabel, early: bool) -> u32 {
    if early { return 1; }
    nested.label.number + nested.label.text.len() + nested.extra
}
fn label_slot_total(slot: LabelSlot) -> u32 {
    match slot {
        LabelSlot::Holds(nested) => nested.label.text.len() + nested.extra,
        LabelSlot::Rows(rows) => label_pair_total(rows, false),
        LabelSlot::Empty => 0,
    }
}
// A String-owning struct moves into a field of another struct, into an enum
// payload, or into an array held by either. The owner then releases the inner
// Strings once, on normal and early exits. `match` of a whole local enum
// binds the payload struct, which is read through its fields. An array moves
// into a payload from a named local, not from a literal.
test fn nested_string_owners() {
    let first_heap := "é".concat("!");
    let first := TextLabel { number: 9, text: first_heap };
    let nested := NestedLabel { label: first, extra: 1 };
    let spare_heap := "é".concat("!");
    let spare_label := TextLabel { number: 1, text: spare_heap };
    let spare := NestedLabel { label: spare_label, extra: 2 };
    let held_heap := "é".concat("!");
    let held_label := TextLabel { number: 2, text: held_heap };
    let held := NestedLabel { label: held_label, extra: 3 };
    let slot := LabelSlot::Holds(held);
    let row_heap := "é".concat("!");
    let row_first := TextLabel { number: 4, text: row_heap };
    let row_second := TextLabel { number: 5, text: "ab" };
    let row_pair := [row_first, row_second];
    let rows := LabelSlot::Rows(row_pair);
    assert(nested_label_total(nested, false) == 13);
    assert(nested_label_total(spare, true) == 1);
    assert(label_slot_total(slot) == 6);
    assert(label_slot_total(rows) == 14);
}
test fn owned_string_struct_result() {
    let made := make_label(4);
    let unused := make_label(1);
    assert(made.number == 4);
    assert(made.text.len() == 3);
    assert(label_total(made, false) == 7);
}
type EditableLabel {
    note: string,
    text: string,
}
fn append_question(text: borrow string) -> string {
    let result := text.concat("?");
    result
}
// A new local struct can take a direct concat or internal String call
// result. Initializers run in source order. A temporary owner is released
// on an early exit from a later initializer. After construction the struct
// owns the bytes and releases them at lexical exit.
test fn temporary_string_fields() {
    let prefix := "é";
    var order: u32 = 0;
    let label := TextLabel {
        text: prefix.concat({ order = 1; "!" }),
        number: { order = order * 10 + 2; order },
    };
    let called := EditableLabel {
        note: append_question(prefix.borrow()),
        text: "",
    };
    assert(label.number == 12);
    assert(byte_is(label.text.byte_at(2), 33));
    assert(byte_is(called.note.byte_at(2), 63));
}
fn inspect_text_label(label: borrow TextLabel) -> bool {
    label.number == 9 && byte_length(label.text.borrow()) == 3
        && byte_is(label.text.byte_at(2), 33)
}
fn inspect_shared_text_label(label: share TextLabel) -> bool {
    label.number == 9 && byte_length(label.text.borrow()) == 3
        && byte_is(label.text.byte_at(2), 33)
}
// Pass an explicit borrow or share of a named owner to a direct internal call.
// The callee reads fields through either parameter. A share is exclusive for
// the call, while the caller still owns the struct and can move it afterwards.
// Whole references cannot be saved in another binding or forwarded.
test fn borrow_string_struct() {
    let prefix := "é";
    var label := TextLabel { text: prefix.concat("!"), number: 9 };
    assert(inspect_text_label(label.borrow()));
    assert(inspect_shared_text_label(label.share()));
    let moved := label;
    assert(inspect_text_label(moved.borrow()));
    assert(moved.text.len() == 3);
}
// Direct String field assignment on a var local consumes a named String
// or stages a literal, concat, or direct internal String call. The RHS can
// borrow the old field. The write releases the old allocation after the RHS
// finishes, and a borrow of a different field can stay live.
test fn replace_local_string_field() {
    var label := EditableLabel { note: "keep", text: "" };
    let note := label.note.borrow();
    let replacement := "é";
    label.text = replacement;
    label.text = label.text.concat("!");
    assert(byte_is(label.text.byte_at(2), 33));
    label.text = append_question(label.text.borrow());
    assert(byte_is(label.text.byte_at(3), 63));
    label.text = "";
    assert(note.len() == 4);
    assert(label.text.len() == 0);
}

// replace(place, value) installs value in a local, field, array element or
// List element and returns the old value, which the caller now owns. The
// value is evaluated first (it may read the old one), then the place is
// addressed and bounds-checked, then the two are exchanged. The owner of the
// place must be a `var` or a `share` parameter.
test fn replace_returns_the_old_value() {
    var title := "draft".concat("");
    let old := replace(title, "final".concat(""));
    assert(old.len() == 5);
    assert(title.len() == 5);
    var counter: u32 = 7;
    assert(replace(counter, 9) == 7);
    assert(counter == 9);
}
// swap(a, b) exchanges two places of one type without copying heap data. The
// places must be provably disjoint: different locals or fields, or distinct
// constant indices. Two dynamic indices into one collection are rejected
// (BE005); swapping them is a later extension.
test fn swap_exchanges_disjoint_places() {
    let first := "alpha".concat("");
    let second := "be".concat("");
    var words: array<string, 2> = [first, second];
    swap(words[0], words[1]);
    assert(words[0].len() == 2);
    assert(words[1].len() == 5);
    var low: u32 = 1;
    var high: u32 = 2;
    swap(low, high);
    assert(low == 2);
}
// Assigning an owning element or field is an RHS-first replacement: the new
// value is evaluated before the old one is released, exactly once.
test fn overwrite_releases_the_old_value() {
    let first := "alpha".concat("");
    let second := "be".concat("");
    var words: array<string, 2> = [first, second];
    words[0] = words[0].concat("!");
    assert(words[0].len() == 6);
    let extra := "x".concat("");
    words[1] = extra;
    assert(words[1].len() == 1);
}
// `x = value` on a whole `var` local, or on a `share` parameter, of any owner
// type (a String-owning struct, tuple, enum or array, a List, a Box or a
// function value) is an RHS-first replacement: the right-hand side is evaluated
// completely first (it may move or read the old value; an early exit leaves
// the old value in place), then what the local still owns is released exactly
// once and the new value is installed. A live loan of the local blocks the
// assignment (BE005).
fn extend_label(label: TextLabel, extra: u32) -> TextLabel {
    let text := label.text.concat("+");
    TextLabel { number: label.number + extra, text: text }
}
fn reset_label(label: share TextLabel, replacement: TextLabel) -> u32 {
    label = replacement;
    label.number
}
fn reassign_unless(early: bool) -> u32 {
    var label := make_label(1);
    let next := make_label(2);
    label = { if early { return 99; } next };
    label.number
}
type Reading [Pending, Done(string)]
test fn whole_owner_reassignment() {
    var label := make_label(1);
    label = make_label(2);
    assert(label.number == 2);
    // The right-hand side may consume the old value ...
    label = extend_label(label, 10);
    assert(label.number == 12);
    assert(label.text.len() == 4);
    // ... in a loop, each round releasing the previous value once.
    loop round in 0..3 { label = extend_label(label, 1); }
    assert(label.number == 15);
    assert(label.text.len() == 7);
    // A moved-out local is initialized again by the assignment.
    let total := label_total(label, false);
    label = make_label(5);
    assert(total == 22 && label.number == 5);
    var numbers := make_words(1);
    numbers = make_words(2);
    assert(numbers.len() == 1 && numbers[0] == 2);
    let heap := "ab".concat("c");
    var pair := (heap, 1);
    let other := "d".concat("e");
    pair = (other, 2);
    assert(pair.1 == 2 && pair.0.len() == 2);
    let word := "xy".concat("z");
    var reading := Reading::Done(word);
    reading = Reading::Pending;
    assert(match reading { Reading::Done(text) => text.len(), Reading::Pending => 0 } == 0);
    let first := "p".concat("q");
    let second := "r".concat("s");
    var pairs: array<string, 2> = [first, second];
    let third := "t".concat("uv");
    let fourth := "w".concat("x");
    pairs = [third, fourth];
    assert(pairs[0].len() == 3);
    var target := make_label(7);
    assert(reset_label(target.share(), make_label(8)) == 8);
    assert(target.number == 8);
    // An early exit in the right-hand side keeps the old value.
    assert(reassign_unless(true) == 99);
    assert(reassign_unless(false) == 2);
}
// An owner temporary can be passed straight to an owned parameter: a struct
// literal or a call result is staged in a hidden local, so the callee still
// receives a named owner and cleanup stays exact.
test fn owner_temporaries_as_arguments() {
    let text := "ab".concat("c");
    assert(label_total(TextLabel { text: text, number: 4 }, false) == 7);
    assert(label_total(make_label(2), false) == 5);
    assert(label_total(TextLabel { text: "lit", number: 1 }, false) == 4);
}
// `replace` takes an `if` or `match` value for an owner place: each branch
// moves its value into the replacement slot, and the other branch's locals are
// released as usual.
type Pick [Left, Right]
test fn replace_with_branch_values() {
    var current := "ab".concat("");
    let first := "xyz".concat("");
    let second := "p".concat("");
    let old := replace(current, if first.len() > 5 { first } else { second });
    assert(old.len() == 2);
    assert(current.len() == 1);
    let third := "mm".concat("");
    let pick := Pick::Left;
    let fourth := "q".concat("");
    let again := replace(current, match pick { Left => third, Right => fourth });
    assert(again.len() == 1);
    assert(current.len() == 2);
}
// A struct literal can mix a String field with an owner field and an array of
// owners; every field moves in and is released with the struct.
type Mixed {
    name: string,
    first: TextLabel,
    rows: array<TextLabel, 2>,
}
test fn mixed_owner_struct_literal() {
    let name := "mix".concat("");
    let first := make_label(1);
    let a := make_label(2);
    let b := make_label(3);
    let mixed := Mixed { name: name, first: first, rows: [a, b] };
    assert(mixed.name.len() == 3);
    assert(mixed.rows[1].number == 3);
}
// An `if` or `match` can produce an owner value (a `string`, a List or a
// String-owning struct, tuple or enum) anywhere a value is accepted: a binding,
// an argument, an assignment or a function result. Each branch moves its value
// into one destination before the branches join, so the branch that is not
// chosen keeps (and later releases) its own locals.
fn pick_text(first: bool) -> string {
    let a := "abc".concat("");
    let b := "xy".concat("");
    if first { a } else { b }
}
fn pick_label(first: bool) -> TextLabel {
    let a := "abc".concat("");
    let b := "xy".concat("");
    if first {
        TextLabel { number: 1, text: a }
    } else {
        TextLabel { number: 2, text: b }
    }
}
test fn if_and_match_produce_owner_values() {
    let a := "abc".concat("");
    let b := "xy".concat("");
    let chosen := if a.len() > 5 { a } else { b };
    assert(chosen.len() == 2);
    assert(pick_text(true).len() == 3);
    let label := pick_label(false);
    assert(label.number == 2);
    assert(label.text.len() == 2);
    let c := "q".concat("");
    let d := "rrrr".concat("");
    let pick := Pick::Right;
    var current := "z".concat("");
    current = match pick { Left => c, Right => d };
    assert(current.len() == 4);
}
// A struct literal can be a function's last expression or a `return` operand.
fn label_tail(number: u32, text: string) -> TextLabel {
    if number == 0 { return TextLabel { number: 9, text: text }; }
    TextLabel { number: number, text: text }
}
test fn struct_literal_as_function_result() {
    let first := "ab".concat("");
    let second := "cde".concat("");
    let one := label_tail(0, first);
    let two := label_tail(4, second);
    assert(one.number == 9);
    assert(one.text.len() == 2);
    assert(two.number == 4);
    assert(two.text.len() == 3);
}
// A heap String or String-owning aggregate that a call returns can be used
// directly: as a function's last expression or `return` operand, a `push`
// argument, a field, an array or tuple element, an enum payload, an assigned
// value or an owned argument. The compiler holds the result in a hidden
// owner, so it is released exactly once, also on an early return.
fn fresh_text() -> string {
    let text := "ab".concat("cd");
    text
}
fn relay_text() -> string { fresh_text() }
fn early_text(early: bool) -> string {
    if early { return fresh_text(); }
    relay_text()
}
fn fresh_label() -> TextLabel { TextLabel { number: 4, text: fresh_text() } }
fn relay_label() -> TextLabel { fresh_label() }
fn text_length(text: string) -> u32 { text.len() }
test fn call_results_in_every_value_position() {
    var words: List<string> = [];
    words.push(fresh_text());
    words.push(early_text(true));
    var current := fresh_text();
    current = relay_text();
    current.push_str(fresh_text());
    let pair := [fresh_text(), early_text(false)];
    let tuple := (fresh_text(), 1);
    let maybe: string? = Some(fresh_text());
    let label := TextLabel { number: 1, text: fresh_text() };
    let relayed := relay_label();
    let chosen := if words.len() > 1 { fresh_text() } else { relay_text() };
    assert(words.len() == 2);
    assert(words[1].len() == 4);
    assert(current.len() == 8);
    assert(pair[0].len() + pair[1].len() == 8);
    assert(tuple.0.len() == 4);
    assert(match maybe { Some(text) => text.len() == 4, None => false });
    assert(label.text.len() == 4);
    assert(relayed.number == 4);
    assert(chosen.len() == 4);
    assert(text_length(fresh_text()) == 4);
    assert(label_total(relay_label(), false) == 8);
}
// Methods take the same arguments as functions: an owned struct, tuple, enum,
// array, List or String moves in (a temporary is staged and released by the
// callee), and `.borrow()` / `.share()` pass a loan for a `borrow` / `share`
// parameter. Only the receiver keeps its own rules. `of Interface` calls and
// generic nominal methods work the same way.
type Meter { base: u32 }
extend Meter {
    fn plus_label(borrow self, label: TextLabel) -> u32 {
        self.base + label.number + label.text.len()
    }
    fn plus_text(borrow self, text: string) -> u32 { self.base + text.len() }
    fn plus_view(borrow self, label: borrow TextLabel) -> u32 {
        self.base + label.number
    }
    fn plus_pair(borrow self, pair: (string, u32)) -> u32 { self.base + pair.0.len() + pair.1 }
}
test fn method_arguments_follow_function_rules() {
    let meter := Meter { base: 100 };
    let kept := relay_label();
    assert(meter.plus_view(kept.borrow()) == 104);
    assert(meter.plus_label(kept) == 108);
    assert(meter.plus_label(relay_label()) == 108);
    assert(meter.plus_label(TextLabel { number: 1, text: "ab" }) == 103);
    assert(meter.plus_text(fresh_text()) == 104);
    assert(meter.plus_text("xyz") == 103);
    assert(meter.plus_pair((fresh_text(), 2)) == 106);
}
