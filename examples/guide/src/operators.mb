// User-defined & selects BitAnd for nominal operands. Primitive u32 `&`
// keeps its existing per-bit operation.
use core::ops::BitAnd;
type MaskLeft { value: u32 }
type MaskRight { value: u32 }
type MaskResult { value: u32 }
extend MaskLeft of BitAnd {
    type Rhs = MaskRight;
    type Output = MaskResult;
    fn bitand(self, rhs: MaskRight) -> MaskResult {
        MaskResult { value: self.value & rhs.value }
    }
}
fn mask<T>(lhs: T, operand: T::Rhs) -> T::Output where T: BitAnd {
    lhs & operand
}
pub fn user_defined_bitand() -> bool {
    let lhs := MaskLeft { value: 12 };
    let operand := MaskRight { value: 10 };
    let result := mask(lhs, operand);
    result.value == 8
}
// User-defined | selects BitOr for nominal operands. Primitive u32 `|`
// remains the built-in per-bit operation.
use core::ops::BitOr;
type MergeLeft { value: u32 }
type MergeRight { value: u32 }
type MergeResult { value: u32 }
extend MergeLeft of BitOr {
    type Rhs = MergeRight;
    type Output = MergeResult;
    fn bitor(self, rhs: MergeRight) -> MergeResult {
        MergeResult { value: self.value | rhs.value }
    }
}
fn merge<T>(lhs: T, operand: T::Rhs) -> T::Output where T: BitOr {
    lhs | operand
}
pub fn user_defined_bitor() -> bool {
    let lhs := MergeLeft { value: 12 };
    let operand := MergeRight { value: 10 };
    let result := merge(lhs, operand);
    result.value == 14
}
// User-defined ^ selects BitXor for nominal operands. Primitive u32 `^`
// keeps its existing per-bit operation.
use core::ops::BitXor;
type XorLeft { value: u32 }
type XorRight { value: u32 }
type XorResult { value: u32 }
extend XorLeft of BitXor {
    type Rhs = XorRight;
    type Output = XorResult;
    fn bitxor(self, rhs: XorRight) -> XorResult {
        XorResult { value: self.value ^ rhs.value }
    }
}
fn xor<T>(lhs: T, operand: T::Rhs) -> T::Output where T: BitXor {
    lhs ^ operand
}
pub fn user_defined_bitxor() -> bool {
    let result := xor(XorLeft { value: 12 }, XorRight { value: 10 });
    result.value == 6
}
// User-defined unary minus selects Neg for nominal values. The receiver is
// owned, and Output may differ from the input type.
use core::ops::Neg;
type NegInput { value: i32 }
type NegResult { value: i32 }
extend NegInput of Neg {
    type Output = NegResult;
    fn neg(self) -> NegResult { NegResult { value: 0 - self.value } }
}
fn negate<T>(value: T) -> T::Output where T: Neg { -value }
pub fn user_defined_negation() -> bool {
    let result := negate(NegInput { value: 42 });
    result.value == -42
}
// Nominal equality borrows its left receiver and consumes the right operand.
use core::ops::PartialEq;
type EqKey { value: u32 }
extend EqKey of PartialEq {
    type Rhs = EqKey;
    fn eq(borrow self, rhs: EqKey) -> bool { self.value == rhs.value }
}
pub fn user_defined_equality() -> bool {
    let left := EqKey { value: 12 };
    let same := EqKey { value: 12 };
    let different := EqKey { value: 13 };
    let equal := left == same;
    let not_equal := left != different;
    equal && not_equal && left.value == 12
}
// Nominal ordering selects the matching PartialOrd member directly.
use core::ops::PartialOrd;
type OrderedKey { value: u32 }
extend OrderedKey of PartialOrd {
    type Rhs = OrderedKey;
    fn lt(borrow self, rhs: OrderedKey) -> bool { self.value < rhs.value }
    fn le(borrow self, rhs: OrderedKey) -> bool { self.value <= rhs.value }
    fn gt(borrow self, rhs: OrderedKey) -> bool { self.value > rhs.value }
    fn ge(borrow self, rhs: OrderedKey) -> bool { self.value >= rhs.value }
}
fn ordered_before<T>(left: T, right: T::Rhs) -> bool where T: PartialOrd { left < right }
pub fn user_defined_ordering() -> bool {
    let left := OrderedKey { value: 12 };
    let right := OrderedKey { value: 13 };
    let same := OrderedKey { value: 12 };
    let lower := OrderedKey { value: 11 };
    let lower_again := OrderedKey { value: 11 };
    let higher := OrderedKey { value: 13 };
    let same_again := OrderedKey { value: 12 };
    let one := OrderedKey { value: 1 };
    let two := OrderedKey { value: 2 };
    left < right && left <= same && higher > lower && left >= lower_again && left >= same_again
        && ordered_before(one, two)
        && left.value == 12
}
// Nominal += selects AddAssign with a shared mutable place and owned RHS.
use core::ops::AddAssign;
type Tally { value: u32 }
type TallyDelta { value: u32 }
extend Tally of AddAssign {
    type Rhs = TallyDelta;
    fn add_assign(share self, rhs: TallyDelta) { self.value += rhs.value; }
}
fn generic_add_assign<T>(target: T, rhs: T::Rhs) -> T where T: AddAssign {
    var value := target;
    value += rhs;
    value
}
pub fn user_defined_add_assign() -> bool {
    var tally := Tally { value: 7 };
    tally += TallyDelta { value: 5 };
    let generic := generic_add_assign(Tally { value: 10 }, TallyDelta { value: 2 });
    var primitive: u32 = 7;
    primitive += 5;
    tally.value == 12 && generic.value == 12 && primitive == 12
}
// Nominal -= selects SubAssign with a shared mutable place and owned Rhs.
// Primitive numeric -= keeps its existing checked arithmetic behavior.
use core::ops::SubAssign;
type Balance { value: u32 }
type BalanceDelta { value: u32 }
extend Balance of SubAssign {
    type Rhs = BalanceDelta;
    fn sub_assign(share self, rhs: BalanceDelta) { self.value -= rhs.value; }
}
fn generic_sub_assign<T>(target: T, rhs: T::Rhs) -> T where T: SubAssign {
    var value := target;
    value -= rhs;
    value
}
pub fn user_defined_sub_assign() -> bool {
    var balance := Balance { value: 19 };
    balance -= BalanceDelta { value: 7 };
    let generic := generic_sub_assign(Balance { value: 20 }, BalanceDelta { value: 8 });
    var primitive: u32 = 19;
    primitive -= 7;
    balance.value == 12 && generic.value == 12 && primitive == 12
}
// Nominal *= selects MulAssign with a shared mutable place and owned Rhs.
// Primitive numeric *= keeps its existing checked arithmetic behavior.
use core::ops::MulAssign;
type Scale { value: u32 }
type ScaleFactor { value: u32 }
extend Scale of MulAssign {
