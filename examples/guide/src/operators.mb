// Nominal /= selects DivAssign with a shared mutable place and owned Rhs.
// Primitive numeric /= retains checked integer division behavior.
use core::ops::DivAssign;
type Portion { value: u32 }
type PortionDelta { value: u32 }
extend Portion of DivAssign {
    type Rhs = PortionDelta;
    fn div_assign(share self, rhs: PortionDelta) { self.value /= rhs.value; }
}
fn generic_div_assign<T>(target: T, rhs: T::Rhs) -> T where T: DivAssign {
    var value := target;
    value /= rhs;
    value
}
pub fn user_defined_div_assign() -> bool {
    var portion := Portion { value: 24 };
    portion /= PortionDelta { value: 3 };
    let generic := generic_div_assign(Portion { value: 81 }, PortionDelta { value: 3 });
    var primitive: u32 = 48;
    primitive /= 4;
    portion.value == 8 && generic.value == 27 && primitive == 12
}
// Nominal %= selects RemAssign with a shared mutable place and owned Rhs.
// Primitive remainder stays checked, including zero and signed overflow rules.
use core::ops::RemAssign;
type Remainder { value: u32 }
type Modulus { value: u32 }
type RemainderHolder { items: array<Remainder, 1> }
extend Remainder of RemAssign {
    type Rhs = Modulus;
    fn rem_assign(share self, rhs: Modulus) { self.value %= rhs.value; }
}
fn generic_rem_assign<T>(target: T, rhs: T::Rhs) -> T where T: RemAssign {
    var value := target;
    value %= rhs;
    value
}
fn generic_rem_array_assign<T, const N: u32>(var values: array<T, N>, index: u32, rhs: T::Rhs) -> array<T, N>
    where T: RemAssign {
    values[index] %= rhs;
    values
}
fn generic_rem_projected_assign<T>(var holder: RemainderHolder, witness: T, rhs: T::Rhs) -> RemainderHolder
    where T: RemAssign {
    holder.items[0] %= rhs;
    holder
}
pub fn user_defined_rem_assign() -> bool {
    var remainder := Remainder { value: 23 };
    let modulus := Modulus { value: 5 };
    remainder %= modulus;
    let generic := generic_rem_assign(Remainder { value: 23 }, Modulus { value: 5 });
    let indexed := generic_rem_array_assign([Remainder { value: 23 }], 0, Modulus { value: 5 });
    remainder.value == 3 && generic.value == 3 && indexed[0].value == 3
}
// Nominal &= selects BitAndAssign with a shared mutable place and owned Rhs.
use core::ops::BitAndAssign;
type PermissionBits { value: u32 }
type PermissionMask { value: u32 }
extend PermissionBits of BitAndAssign {
    type Rhs = PermissionMask;
    fn bitand_assign(share self, rhs: PermissionMask) { self.value &= rhs.value; }
}
fn generic_bitand_assign<T>(target: T, rhs: T::Rhs) -> T where T: BitAndAssign {
    var value := target;
    value &= rhs;
    value
}
pub fn user_defined_bitand_assign() -> bool {
    var permissions := PermissionBits { value: 15 };
    let mask := PermissionMask { value: 6 };
    permissions &= mask;
    let generic := generic_bitand_assign(PermissionBits { value: 15 }, PermissionMask { value: 6 });
    permissions.value == 6 && generic.value == 6
}
// Nominal |= selects BitOrAssign and keeps the same single-evaluation place rules.
use core::ops::BitOrAssign;
type FeatureBits { value: u32 }
type FeatureMask { value: u32 }
extend FeatureBits of BitOrAssign {
    type Rhs = FeatureMask;
    fn bitor_assign(share self, rhs: FeatureMask) { self.value |= rhs.value; }
}
fn generic_bitor_assign<T>(target: T, rhs: T::Rhs) -> T where T: BitOrAssign {
    var value := target;
    value |= rhs;
    value
}
pub fn user_defined_bitor_assign() -> bool {
    var features := FeatureBits { value: 8 };
    let mask := FeatureMask { value: 3 };
    features |= mask;
    let generic := generic_bitor_assign(FeatureBits { value: 8 }, FeatureMask { value: 3 });
    features.value == 11 && generic.value == 11
}
// Nominal ^= selects BitXorAssign; primitive u32 keeps per-bit XOR behavior.
use core::ops::BitXorAssign;
type FeatureDelta { value: u32 }
extend FeatureBits of BitXorAssign {
    type Rhs = FeatureDelta;
    fn bitxor_assign(share self, rhs: FeatureDelta) { self.value ^= rhs.value; }
}
fn generic_bitxor_assign<T>(target: T, rhs: T::Rhs) -> T where T: BitXorAssign {
    var value := target;
    value ^= rhs;
    value
}
pub fn user_defined_bitxor_assign() -> bool {
    var features := FeatureBits { value: 10 };
    let delta := FeatureDelta { value: 3 };
    features ^= delta;
    let generic := generic_bitxor_assign(FeatureBits { value: 10 }, FeatureDelta { value: 3 });
    features.value == 9 && generic.value == 9
}
// User-defined << selects Shl for nominal operands. Primitive u32 shifts
// reject counts at or above 32, statically or at runtime.
use core::ops::Shl;
type ShiftLeft { value: u32 }
type ShiftCount { value: u32 }
type ShiftResult { value: u32 }
extend ShiftLeft of Shl {
    type Rhs = ShiftCount;
    type Output = ShiftResult;
    fn shl(self, rhs: ShiftCount) -> ShiftResult {
        ShiftResult { value: self.value << rhs.value }
    }
}
fn shift<T>(lhs: T, count: T::Rhs) -> T::Output where T: Shl {
    lhs << count
}
pub fn user_defined_shl() -> bool {
    let result := shift(ShiftLeft { value: 3 }, ShiftCount { value: 4 });
    result.value == 48
}
// Nominal <<= selects ShlAssign with the same checked place sequencing.
use core::ops::ShlAssign;
extend ShiftLeft of ShlAssign {
    type Rhs = ShiftCount;
    fn shl_assign(share self, rhs: ShiftCount) { self.value <<= rhs.value; }
}
fn generic_shl_assign<T>(target: T, rhs: T::Rhs) -> T where T: ShlAssign {
    var value := target;
    value <<= rhs;
    value
}
pub fn user_defined_shl_assign() -> bool {
    var value := ShiftLeft { value: 3 };
    let count := ShiftCount { value: 4 };
    value <<= count;
    let generic := generic_shl_assign(ShiftLeft { value: 3 }, ShiftCount { value: 4 });
    var primitive: u32 = 3;
    primitive <<= 4;
    value.value == 48 && generic.value == 48 && primitive == 48
}
// Nominal >>= uses ShrAssign; primitive u32 counts must be below 32.
use core::ops::ShrAssign;
extend ShiftRight of ShrAssign {
    type Rhs = ShiftAmount;
    fn shr_assign(share self, rhs: ShiftAmount) { self.value >>= rhs.value; }
}
fn generic_shr_assign<T>(target: T, rhs: T::Rhs) -> T where T: ShrAssign {
    var value := target;
    value >>= rhs;
    value
}
pub fn user_defined_shr_assign() -> bool {
    var value := ShiftRight { value: 48 };
    let count := ShiftAmount { value: 2 };
    value >>= count;
    var primitive: u32 = 48;
    primitive >>= 2;
    let generic := generic_shr_assign(ShiftRight { value: 48 }, ShiftAmount { value: 2 });
    value.value == 12 && primitive == 12 && generic.value == 12
}
// A single generic bound forwards selected assignment evidence through owned
// locals, indexed array<T, N> elements and a field-then-index projected place.
pub fn generic_compound_assignments() -> bool {
    let remainder := generic_rem_assign(Remainder { value: 23 }, Modulus { value: 5 });
    let remainder_items := generic_rem_array_assign(
        [Remainder { value: 23 }, Remainder { value: 19 }], 1, Modulus { value: 7 }
    );
    let remainder_holder := generic_rem_projected_assign(
        RemainderHolder { items: [Remainder { value: 23 }] }, Remainder { value: 0 }, Modulus { value: 5 }
    );
    let permissions := generic_bitand_assign(
        PermissionBits { value: 15 }, PermissionMask { value: 6 }
    );
    let features_or := generic_bitor_assign(FeatureBits { value: 8 }, FeatureMask { value: 3 });
    let features_xor := generic_bitxor_assign(FeatureBits { value: 10 }, FeatureDelta { value: 3 });
    let shifted := generic_shl_assign(ShiftLeft { value: 3 }, ShiftCount { value: 4 });
    remainder.value == 3 && remainder_items[1].value == 5 && remainder_holder.items[0].value == 3
        && permissions.value == 6 && features_or.value == 11
        && features_xor.value == 9 && shifted.value == 48
}
// User-defined >> selects Shr and may use a distinct RHS type.
use core::ops::Shr;
type ShiftRight { value: u32 }
type ShiftAmount { value: u32 }
type Shifted { value: u32 }
extend ShiftRight of Shr {
    type Rhs = ShiftAmount;
    type Output = Shifted;
    fn shr(self, rhs: ShiftAmount) -> Shifted {
        Shifted { value: self.value >> rhs.value }
    }
}
fn shift_right<T>(lhs: T, count: T::Rhs) -> T::Output where T: Shr {
    lhs >> count
}
pub fn user_defined_shr() -> bool {
    let result := shift_right(ShiftRight { value: 48 }, ShiftAmount { value: 2 });
    result.value == 12
}
