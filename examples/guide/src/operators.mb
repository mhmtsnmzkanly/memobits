    value *= rhs;
    value
}
pub fn user_defined_mul_assign() -> bool {
    var scale := Scale { value: 6 };
    scale *= ScaleFactor { value: 7 };
    let generic := generic_mul_assign(Scale { value: 6 }, ScaleFactor { value: 7 });
    var primitive: u32 = 6;
    primitive *= 7;
    scale.value == 42 && generic.value == 42 && primitive == 42
