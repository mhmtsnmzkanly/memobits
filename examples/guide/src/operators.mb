// User-defined + selects the compiler-provided core::ops::Add interface.
// Associated Rhs and Output permit a heterogeneous owned operation. Generic
// signatures project both types through the caller-selected Add evidence;
// primitive arithmetic remains checked and built in.
use core::ops::Add;
type AddPoint { value: i32 }
type AddRight { value: i32 }
type AddResult { value: i32 }
extend AddPoint of Add {
    type Rhs = AddRight;
    type Output = AddResult;
    fn add(self, rhs: AddRight) -> AddResult {
        AddResult { value: self.value + rhs.value }
    }
}
fn add_points<T>(left: T, right: T::Rhs) -> T::Output where T: Add {
    left + right
}
pub fn user_defined_add() -> bool {
    let left := AddPoint { value: 20 };
    let right := AddRight { value: 22 };
    let total := add_points(left, right);
    total.value == 42
}
// User-defined - follows the same owned associated-type contract through
// core::ops::Sub. Primitive subtraction stays built in and checked.
use core::ops::Sub;
type SubLeft { value: i32 }
type SubRight { value: i32 }
type SubResult { value: i32 }
extend SubLeft of Sub {
    type Rhs = SubRight;
    type Output = SubResult;
    fn sub(self, rhs: SubRight) -> SubResult {
        SubResult { value: self.value - rhs.value }
    }
}
fn subtract<T>(left: T, right: T::Rhs) -> T::Output where T: Sub {
    left - right
}
pub fn user_defined_sub() -> bool {
    let difference := subtract(SubLeft { value: 50 }, SubRight { value: 8 });
    difference.value == 42
}
