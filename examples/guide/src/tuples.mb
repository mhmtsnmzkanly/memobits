// Tuples preserve element order in local values and internal calls. Numeric
// projections use `.0`, `.1`; labels are occurrence-local projection aliases.
// Positional destructuring consumes every slot of a named tuple local,
// including direct owned String elements. Nested tuple patterns and `_`
// discards are supported; discarded String slots still receive normal cleanup.
// A temporary tuple with owned String slots can move into an owned internal
// call. Nested String-owning tuples can also move through tuple slots and
// internal signatures, and can be stored in local nominal record fields and
// fixed arrays. Array and tuple scope cleanup releases each owned String.
// Enums can own Strings, tuples, or fixed-array payloads, including nested
// String-owning tuples, and release only the active payload on a match or exit.
// String-owning nominal structs move by value as owned internal arguments and
// results, and nest in tuples, structs, enum payloads and fixed arrays (see
// `owned_string_struct_argument`). Destructuring aliases, partial
// destructuring, and moving a field or element out of a live owner remain
// unsupported.
type NestedTupleRecord { values: (string, string), count: u32 }
type TextState [Texts((string, string), u32), Discarded((string, string), (string, string)), Empty]
type TextBatch [Rows(array<(string, u32), 2>), Single((string, u32)), Plain(string), Empty]

// Fixed arrays can contain scalar and String-owning tuples, and tuples can
// contain fixed arrays.
fn sum_string_rows(rows: array<(string, u32), 2>) -> u32 {
    rows[0].1 + rows[1].1
}

fn consume_text_batches(batches: array<TextBatch, 3>, early: bool) -> bool {
    if early { return false; }
    true
}

test fn tuple_array_values() {
    let rows: array<(i32, bool), 2> = [(40, false), (2, true)];
    let first := "first".concat("");
    let second := "second".concat("");
    let first_row: (string, u32) = (first, 20);
    let second_row: (string, u32) = (second, 22);
    let owned_rows: array<(string, u32), 2> = [first_row, second_row];
    let third := "third".concat("");
    let fourth := "fourth".concat("");
    let fifth := "fifth".concat("");
    let sixth := "sixth".concat("");
    let batch_first: (string, u32) = (third, 20);
    let batch_second: (string, u32) = (fourth, 22);
    let batch_single: (string, u32) = (fifth, 7);
    let batch_plain: TextBatch = TextBatch::Plain(sixth);
    let batch_rows: array<(string, u32), 2> = [batch_first, batch_second];
    let rows_state: TextBatch = TextBatch::Rows(batch_rows);
    let single_state: TextBatch = TextBatch::Single(batch_single);
    let batches: array<TextBatch, 3> = [rows_state, single_state, batch_plain];
    let nested := (rows, 0);
    assert(nested.0[1].1);
    assert(nested.0[0].0 + nested.0[1].0 + nested.1 == 42);
    assert(sum_string_rows(owned_rows) == 42);
    assert(consume_text_batches(batches, false));
}

fn echo_pair(pair: (i32, bool)) -> (i32, bool) { (pair.0, pair.1) }
fn labeled_left(pair: (left: i32, right: i32)) -> i32 { pair.left }
fn reversed_labeled_left(pair: (right: i32, left: i32)) -> i32 { pair.left }

fn forward_owned_pair(pair: (string, u32), early: bool) -> (string, u32) {
    if early { return pair; }
    pair
}

fn consume_owned_texts(pair: (string, string, u32)) -> u32 {
    let (left, right, base) := pair;
    left.len() + right.len() + base
}

fn forward_nested_text(pair: ((string, string), u32)) -> ((string, string), u32) { pair }

fn consume_nested_text(pair: ((string, string), u32)) -> u32 {
    let ((left, right), base) := pair;
    left.len() + right.len() + base
}

test fn owned_tuple_temporary_call() {
    let left := "xy".concat("!");
    let right := "ab".concat("?");
    assert(consume_owned_texts((left, right, 36 as u32)) == 42);
}

test fn nested_owned_tuple_temporary_call() {
    let left := "ab".concat("");
    let right := "cd".concat("");
    let inner := (left, right);
    assert(consume_nested_text(forward_nested_text((inner, 38 as u32))) == 42);
}

test fn nested_owned_tuple_record_field() {
    let left := "ab".concat("");
    let right := "cd".concat("");
    let values := (left, right);
    let record := NestedTupleRecord { values: values, count: 38 as u32 };
    assert(record.values.0.len() == 2);
    assert(record.values.1.len() == 2);
    assert(record.count == 38);
}

fn package_text_state(pair: (string, string), count: u32) -> TextState {
    TextState::Texts(pair, count)
}

fn consume_text_state(state: TextState) -> u32 {
    match state {
        TextState::Texts(pair, count) => {
            let (left, right) := pair;
            left.len() + right.len() + count
        }
        TextState::Discarded(pair, _) => {
            let (left, right) := pair;
            left.len() + right.len()
        }
        TextState::Empty => 0,
    }
}

fn early_text_state_exit(state: TextState, flag: bool) -> u32 {
    if flag { return 1; }
    consume_text_state(state)
}

test fn tuple_enum_payloads() {
    let left := "ab".concat("");
    let right := "cd".concat("");
    let early := early_text_state_exit(package_text_state((left, right), 90 as u32), true);
    let first := "ab".concat("");
    let second := "cd".concat("");
    let a := "ab".concat("");
    let b := "cd".concat("");
    let c := "ef".concat("");
    let d := "gh".concat("");
    assert(early + consume_text_state(package_text_state((first, second), 38 as u32)) == 43);
    assert(consume_text_state(TextState::Discarded((a, b), (c, d))) == 4);
}

test fn tuple_values() {
    let pair := echo_pair((40, true));
    let (number, enabled) := pair;
    let text := "owned".concat("!");
    let text_pair := (text, 40 as u32);
    let owned := forward_owned_pair(text_pair, true);
    // The returned tuple is first bound to `owned`, then fully destructured.
    let (owned_text, count) := owned;
    let discarded := "discarded".concat("!");
    let nested_owned := ((42, true), discarded);
    let ((nested_number, nested_enabled), _) := nested_owned;
    assert(number == 40);
    assert(enabled);
    assert(owned_text.len() == 6);
    assert(count == 40);
    assert(nested_number == 42);
    assert(nested_enabled);
    assert(labeled_left((left: 40, right: 0)) + reversed_labeled_left((right: 0, left: 2)) == 42);
}

// A tuple may hold an enum that owns Strings. It can be built from a call
// result, passed to an owned call, returned, stored in an array and matched in
// place or by value.
fn heap_text(base: string) -> string {
    let text := base.concat("");
    text
}

type Token [Word(string), Num(i32)]
fn token() -> Token { Token::Word(heap_text("abcd")) }
fn token_pair() -> (Token, i32) { (token(), 7) }

fn token_total(pair: (Token, i32)) -> i32 {
    match pair { (Token::Word(w), n) => w.len() as i32 + n, (Token::Num(n), m) => n + m }
}

test fn tuples_with_string_owning_enums() {
    let built := (token(), 1);
    assert(token_total(built) == 5);
    assert(token_total(token_pair()) == 11);
    assert(token_total((Token::Num(3), 4)) == 7);
    let rows := [(token(), 1), (Token::Num(3), 2)];
    assert(match rows[0] {
        (Token::Word(w), n) => w.len() as i32 + n == 5,
        (Token::Num(_), _) => false,
    });
    assert(match rows[1] { (Token::Word(_), _) => false, (Token::Num(n), m) => n * m == 6 });
}
