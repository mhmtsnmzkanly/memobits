use collections::{Row, total};

type Signal [Start, Stop] extend {
    fn is_active(borrow self) -> bool {
        match self {
            Signal::Start => true,
            Signal::Stop => false,
        }
    }
}
pub fn trailing_enum_extension() -> bool {
    let signal := Signal::Start;
    signal.is_active()
}
// Postfix `T?` is the preferred spelling of an optional type. The legacy
// `T?` spelling is still accepted silently with identical meaning;
// this guide uses `T?` throughout. Grouping matters for
// references: `(borrow T)?` is an optional borrow, while `borrow T?` borrows
// an optional value. Contextual Some and None construction keeps the existing
// Option representation and match behavior.
pub fn optional_sugar() -> bool {
    let present: i32? = Some(40);
    let absent: i32? = None;
    (match present {
        Some(value) => value == 40,
        None => false,
    }) && (match absent {
        Some(_) => false,
        None => true,
    })
}
// A `string ! E` may be stored in a struct field or a fixed-array element
// while its Ok payload is a String literal. Heap Ok payloads are rejected
// there (TE018); they must be matched immediately as shown above.
type Outcome { text: string ! Error, tag: u32 }
fn failure_code(items: array<string ! Error, 2>) -> u32 {
    match items[1] { Ok(_) => 0 as u32, Err(error) => error.code }
}
pub fn nested_result_storage() -> bool {
    let ok: string ! Error = Ok("é");
    let stored := Outcome { text: ok, tag: 3 };
    let failed: string ! Error = Err(Error { code: 8 });
    let failed_outcome := Outcome { text: failed, tag: 4 };
    let from_field := match failed_outcome.text { Ok(_) => 0 as u32, Err(error) => error.code };
    let first: string ! Error = Ok("x");
    let second: string ! Error = Err(Error { code: 9 });
    let items := [first, second];
    stored.tag == 3 && from_field == 8 && failure_code(items) == 9
}
// Nested patterns. A variant or tuple pattern may hold further patterns at any
// depth, with `_` and bindings in any position. The compiler checks the whole
// pattern matrix: a missing case such as `Ok(None)` is reported with an example
// pattern, and an arm that earlier arms already cover is an error. An owned
// match consumes the value, moves the bound parts out and releases the rest;
// a borrowed match copies primitives and lends aggregates.
type Spot [ Empty, At(i32, i32) ]
type Link [ Direct(Spot), Via(Spot, Spot), Lost ]
fn probe(reading: u32? ! Error) -> u32 {
    match reading {
        Ok(Some(value)) => value,
        Ok(None) => 100,
        Err(error) => 200 + error.code,
    }
}
fn route(link: borrow Link) -> i32 {
    match link {
        Link::Direct(Spot::At(x, y)) => x + y,
        Link::Via(Spot::Empty, Spot::At(x, _)) => x,
        Link::Via(_, _) => -1,
        Link::Direct(Spot::Empty) => 0,
        Link::Lost => -2,
    }
}
fn join(first: i32?, second: i32?) -> i32 {
    match (first, second) {
        (Some(a), Some(b)) => a + b,
        (Some(a), None) => a,
        (None, other) => match other { Some(b) => b, None => 0 },
    }
}
pub fn nested_patterns() -> bool {
    let found: u32? ! Error = Ok(Some(5));
    let absent: u32? ! Error = Ok(None);
    let failed: u32? ! Error = Err(Error { code: 3 });
    let direct := Link::Direct(Spot::At(2, 3));
    let via := Link::Via(Spot::Empty, Spot::At(7, 8));
    probe(found) == 5 && probe(absent) == 100 && probe(failed) == 203
        && route(direct.borrow()) == 5 && route(via.borrow()) == 7
        && join(Some(1), Some(2)) == 3 && join(None, Some(4)) == 4
}
// Enums and exhaustive matching. An alias can also qualify variants.
type Reading [ Missing, Single(i32), Batch(Row, bool) ]
type Sample = Reading;
fn inspect(sample: borrow Reading) -> i32 {
    // Borrow matching copies primitive payloads and lends aggregate payloads.
    match sample {
        Sample::Missing => 0,
        Sample::Single(value) => value,
        Sample::Batch(row, _) => total(row),
    }
}
fn take(sample: Reading) -> i32 {
    // Owned matching consumes the enum. Here row is an owned array.
    match sample {
        Reading::Batch(row, valid) => {
            if valid { total(row.borrow()) } else { 0 }
        },
        _ => 0, // A wildcard covers the remaining variants.
    }
}
pub fn enums() -> bool {
    let readings := [Reading::Missing, Sample::Single(6)];
    // Matching an array element also borrows in place.
    let single := match readings[1] { Sample::Single(value) => value, _ => 0 };
    let batch := Reading::Batch([2, 3, 4], true);
    inspect(readings[0].borrow()) == 0 && single == 6
        && inspect(batch.borrow()) == 9 && take(batch) == 9
}
// References and a function-local `(borrow T)?`.
fn read(value: borrow i32) -> i32 {
    value.copy()
}
pub fn optional_borrow() -> bool {
    var owner := 7;
    var editor := owner.share(); // A stored mutable handle uses var.
    editor += 1;
    let saved := read(editor); // Reborrow the share for read-only access.
    // The share ended at its last use. The annotation supplies the borrow
    // payload type. Moving the wrapper transfers the handle and its loan.
    let wrapped: (borrow i32)? = Some(owner.borrow());
    let moved := wrapped;
    let snapshot := match moved { Some(view) => read(view), None => 0 };
    owner = 9; // The consuming match and the last use of view release the loan.

    let empty: (borrow i32)? = None;
    let fallback := match empty { Some(view) => view.copy(), None => owner };
    saved == 8 && snapshot == 8 && fallback == 9
}
// Borrow optionals support direct annotations on immutable locals and consuming
// matches. Aliases, fields, nesting, signatures and branch results are gated.
// Reference returns, rebinding and loans of primitive projections such as
// row[0].borrow() are also outside the current subset.
// Owned outcomes and nominal errors.
type ReadingError: Error {
    pub station_id: u32,
}
type RangeError: ReadingError {
    observed: i32,
}
type Checked = Row ! RangeError;
// `T ?! E` is exactly `T? ! E`: Ok(Some(v)), Ok(None) or Err(e).
type Poll = i32? ?! RangeError;
fn replace_context(context: share ReadingError) {
    // A whole write through an ancestor share updates its visible fields.
    // The descendant keeps its concrete type and its observed field.
    context = ReadingError { code: 12, station_id: 7 };
}
fn error_code(error: borrow Error) -> u32 {
    error.code
}
fn check(value: i32) -> Checked {
    if value < 0 {
        // Every inherited field needs an initializer, including Error.code.
        Err(RangeError { code: 1, station_id: 0, observed: value })
    } else {
        Ok([value, value + 1, value + 2])
    }
}
fn poll(enabled: bool, value: i32) -> Poll {
    // Ok(None) means the operation was skipped.
    if !enabled { return Ok(None); }
    match check(value) {
        Ok(row) => {
            // Some can infer an owned Option from its payload. Bare None
            // needs an expected type, here supplied by the Poll return type.
            if row[0] == 0 {
                Ok(Some(None))
            } else {
                let reading := Some(total(row.borrow()));
                Ok(Some(reading))
            }
        },
        Err(error) => Err(error),
    }
}
pub fn outcomes() -> bool {
    // Nested patterns match through all three layers.
    let done := match poll(true, 2) {
        Ok(Some(Some(value))) => value == 9,
        _ => false,
    };
    // Ok(Some(None)) means the operation ran and found no reading.
    let empty := match poll(true, 0) {
        Ok(Some(None)) => true,
        _ => false,
    };
    let skipped := match poll(false, 2) { Ok(None) => true, _ => false };
    let failed := match poll(true, -4) {
        Err(error) => {
            var error := error;
            replace_context(error.share()); // RangeError to ReadingError.
            error_code(error.borrow()) == 12 // RangeError to its root Error.
                && error.station_id == 7 && error.observed == -4
        },
        _ => false,
    };
    done && empty && skipped && failed
}
// Ancestor reference conversion works at direct internal calls. Owned
// conversion to an ancestor is unavailable. `T ! E` and `T ?! E` require Error
// or a nominal descendant as their error argument.
