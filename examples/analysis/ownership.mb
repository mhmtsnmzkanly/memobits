// Run with `mb ownership examples/analysis/ownership.mb`.
fn consume_pair(first: Array<i32, 2>, second: i32) {}

fn main() -> i32 {
    var values := [10, 11];
    // The first argument moves the array before the second restores it.
    consume_pair(values, { values = [20, 21]; 0 });
    // Primitive reads copy implicitly, so repeated reads and shadowing are free.
    let total := values[0] + values[1];
    let again := total;
    total + again
}
