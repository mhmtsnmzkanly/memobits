    let heap := "é".concat("!");
    let made: { name: string, size: u32 } = { name: heap, size: 4 };
    made
}
fn record_slot_total(slot: RecordSlot) -> u32 {
    match slot {
        RecordSlot::HasRecord(value) => value.name.len() + value.size,
        RecordSlot::NoRecord => 0,
    }
}
fn string_owning_records() -> Bool {
    let heap := "é".concat("!");
    let named: { name: string, size: u32 } = { name: heap, size: 9 };
    let spare_heap := "é".concat("!");
    let spare: { name: string, size: u32 } = { name: spare_heap, size: 1 };
    let made := make_named_record();
    let slot_heap := "é".concat("!");
