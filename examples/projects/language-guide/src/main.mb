// Start at main, then follow the checks. Both source and Wasm runs should
// print Result: Ok(i32(42)). Each error code identifies a failed check.

/* Numbers and control flow. Block comments can /* nest */. */
fn numbers() -> Bool {
    // An annotation supplies the literal type. Without context, integers
    // default to i32 and floats to f64.
    let a: i8 = -8;
    let b: i16 = -160;
    let c := 3_200;
    let d: i64 = 6_400;
    let e: u8 = 8;
    let f: u16 = 160;
    let g: u32 = 320;
    let h: u64 = 640;
    let half: f32 = 5e-1;
    let quarter := 0.25;

    // var permits assignment. let creates an immutable binding.
    var step := 0;
    var sum := 0;
    loop {
        step += 1;
        if step > 5 { break; }
        if step % 2 == 0 { continue; }
        sum += step;
    }
    // A new binding can shadow the old one. A tail expression yields a value.
    let sum := { let offset := 1; sum + offset };
    if !(sum == 10) { return false; }
    let divisor := step - 6;
    // Short-circuit evaluation skips the division when divisor is zero.
    if divisor == 0 || sum / divisor > 0 {
        a < 0 && b <= -160 && c >= 3_200 && d != 0
            && e * 2 == 16 && f - 10 == 150 && g / 2 == 160 && h % 3 == 1
            && half + 0.5 == 1.0 && quarter * 4.0 == 1.0
    } else {
        false
    }
}
// Integer arithmetic and array indexing are checked. Proven invalid cases
// can fail compilation. Dynamic overflow, zero divisors and invalid indices
// trap at runtime. Floats use IEEE arithmetic.

// Fixed arrays, structs, and ownership.
type Row = Array<i32, 3>;
type Station {
    id: u32,
    readings: Row,
}

fn station(id: u32) -> Station {
    // Every field must be initialized. The order here can differ from the type.
    Station { readings: [0; 3], id: id }
}

fn record(row: share Row, index: i32, reading: i32) {
    // share grants exclusive write access. The caller sees the update.
    row[index] = reading;
    return;
}

fn total(row: borrow Row) -> i32 {
    // borrow grants read-only access. Primitive values copy implicitly;
    // .copy() makes the same read explicit.
    let first := row[0];
    first + row[1].copy() + row[2]
}

fn calibrate(var row: Row) -> Row {
    // An owned parameter takes the caller's array. var lets this function edit it.
    row[0] -= 1;
    row[1] *= 2;
    row[2] /= 2;
    row[2] %= 3;
    row
}

fn stations() -> Bool {
    // Repetition calls station once per element.
    var pair := [station(7); 2];
    pair[0].readings = [4, 5, 8];
    let left := pair[0].borrow();
    // Constant indices 0 and 1 are disjoint. A dynamic index can overlap both.
    record(pair[1].readings.share(), 2, 9);
    let before := total(left.readings.borrow());
    pair[0] = station(8); // The loan ended at the last use of left.

    var sample := station(7);
    sample.readings = if before == 17 { [4, 5, 8] } else { [0; 3] };
    let readings := sample.readings.borrow();
    sample.id = 8; // A different field is also disjoint.
    let recorded := total(readings);
    let moved := sample; // Moving an aggregate consumes its old binding.
    let Station { id, readings: row } := moved;
    // Destructuring consumes the whole struct. Moving a single aggregate
    // field or element out of its owner is unsupported.
    let adjusted := calibrate(row);
    let grid := [[1, 2, 3], adjusted];
    id == 8 && recorded == 17 && total(grid[1].borrow()) == 14
        && pair[1].readings[2] == 9
}

// Bytes<N> is a built-in spelling for Array<u8, N>. Either spelling works
// across assignments, calls, and returns, including borrowed and shared calls.
fn set_first_byte(buffer: share Array<u8, 2>) {
    buffer[0] = 42;
}

fn first_byte(buffer: borrow Bytes<2>) -> u8 {
    buffer[0]
}

fn return_bytes(buffer: Array<u8, 2>) -> Bytes<2> {
    buffer
}

fn fixed_bytes() -> Bool {
    var bytes: Bytes<2> = [0; 2];
    set_first_byte(bytes.share());
    let array: Array<u8, 2> = return_bytes(bytes); // Moves the whole buffer.
    first_byte(array.borrow()) == 42
}

// String literals are owned UTF-8. The empty literal is also a String.
fn text() -> String {
    "café 😀"
}

fn byte_length(value: borrow String) -> u32 {
    value.len()
}

fn fixed_text() -> Bool {
    let caption := text();
    let view := caption.borrow();
    // A shared read-only loan allows the owner to be read too.
    let while_borrowed := caption.len();
    let borrowed := byte_length(view);
    let moved := caption; // The borrow ended at its last use.
    // Length counts UTF-8 bytes. The accented letter takes two and the
    // emoji takes four. Reading the length does not consume the String.
    while_borrowed == 10 && borrowed == 10 && moved.len() == 10
        && moved.len() == text().len()
        && "".len() == 0 && "abc".len() == 3 && "é".len() == 2 && "😀".len() == 4
}

fn byte_is(byte: Option<u8>, expected: u8) -> Bool {
    match byte { Some(value) => value == expected, None => false }
}

fn no_byte(byte: Option<u8>) -> Bool {
    match byte { Some(_) => false, None => true }
}

fn text_bytes() -> Bool {
    let value := "é😀";
    let view := value.borrow();
    // byte_at reads raw UTF-8, including continuation bytes.
    let lead := value.byte_at(0);
    let continuation := view.byte_at(1);
    let moved := value; // The last byte read through view released its loan.
    byte_is(lead, 195) && byte_is(continuation, 169)
        && byte_is(moved.byte_at(2), 240) && byte_is(moved.byte_at(3), 159)
        && byte_is(moved.byte_at(4), 152) && byte_is(moved.byte_at(5), 128)
        && no_byte(moved.byte_at(6)) && no_byte(moved.byte_at(4_294_967_295))
        && no_byte("".byte_at(0))
}

fn scalar_is(scalar: Option<u32>, expected: u32) -> Bool {
    match scalar { Some(value) => value == expected, None => false }
}

fn no_scalar(scalar: Option<u32>) -> Bool {
    match scalar { Some(_) => false, None => true }
}

fn text_scalars() -> Bool {
    let value := "aé€😀";
    let view := value.borrow();
    // Indices are byte offsets. Successful results are Unicode scalar values.
    let ascii := value.scalar_at(0);
    let accent := view.scalar_at(1);
    let moved := value;
    scalar_is(ascii, 97) && scalar_is(accent, 233)
        && scalar_is(moved.scalar_at(3), 8_364) && scalar_is(moved.scalar_at(6), 128_512)
        && no_scalar(moved.scalar_at(2)) && no_scalar(moved.scalar_at(4))
        && no_scalar(moved.scalar_at(5)) && no_scalar(moved.scalar_at(7))
        && no_scalar(moved.scalar_at(8)) && no_scalar(moved.scalar_at(9))
        && no_scalar(moved.scalar_at(10)) && no_scalar(moved.scalar_at(11))
        && no_scalar(moved.scalar_at(4_294_967_295)) && no_scalar("".scalar_at(0))
}

fn scalar_width(value: u32) -> u32 {
    // scalar_at returns valid scalar values, so the numeric range determines
    // how many UTF-8 bytes to advance.
    if value <= 127 { 1 }
    else if value <= 2_047 { 2 }
    else if value <= 65_535 { 3 }
    else { 4 }
}

fn walk_text(value: borrow String) -> Bool {
    let starts: Array<u32, 4> = [0, 1, 3, 6];
    let scalars: Array<u32, 4> = [97, 233, 8_364, 128_512];
    let end := value.len();
    var offset: u32 = 0;
    var visited := 0;
    loop {
        if offset == end { break; }
        if visited == 4 { return false; }
        let scalar := match value.scalar_at(offset) {
            Some(decoded) => decoded,
            None => { return false; },
        };
        if offset != starts[visited] || scalar != scalars[visited] { return false; }
        offset += scalar_width(scalar);
        visited += 1;
    }
    visited == 4 && offset == 10
}

fn text_boundaries() -> Bool {
    let value := "aé€😀";
    let view := value.borrow();
    // Byte offsets 0, 1, 3 and 6 start scalars. The byte length, 10,
    // is also a boundary. Continuation bytes and past-end offsets are not.
    value.is_char_boundary(0) && view.is_char_boundary(1)
        && view.is_char_boundary(3) && view.is_char_boundary(6)
        && view.is_char_boundary(10)
        && !view.is_char_boundary(2) && !view.is_char_boundary(4)
        && !view.is_char_boundary(5) && !view.is_char_boundary(7)
        && !view.is_char_boundary(8) && !view.is_char_boundary(9)
        && !view.is_char_boundary(11) && !view.is_char_boundary(4_294_967_295)
        && "".is_char_boundary(0) && !"".is_char_boundary(1)
}

fn text_concat() -> Bool {
    let left := "café";
    let right := "😀";
    // concat borrows both inputs. The new String owns its bytes until this
    // binding leaves scope. This slice keeps it in the original let binding.
    let joined := left.concat(right.borrow());
    let left_moved := left;
    let with_suffix := joined.concat("!");
    let empty := "".concat("");
    byte_length(joined.borrow()) == 9 && left_moved.len() == 5
        && byte_is(joined.byte_at(4), 169) && scalar_is(joined.scalar_at(5), 128_512)
        && with_suffix.len() == 10 && byte_is(with_suffix.byte_at(9), 33)
        && empty.len() == 0 && no_byte(empty.byte_at(0))
}

// Enums and exhaustive matching. An alias can also qualify variants.
type Reading [ Missing, Single(i32), Batch(Row, Bool) ]
type Sample = Reading;

fn inspect(sample: borrow Reading) -> i32 {
    // Borrow matching copies primitive payloads and lends aggregate payloads.
    match sample {
        Sample::Missing => 0,
        Sample::Single(value) => value,
        Sample::Batch(row, _) => total(row),
    }
}

fn take(sample: Reading) -> i32 {
    // Owned matching consumes the enum. Here row is an owned array.
    match sample {
        Reading::Batch(row, valid) => {
            if valid { total(row.borrow()) } else { 0 }
        },
        _ => 0, // A wildcard covers the remaining variants.
    }
}

fn enums() -> Bool {
    let readings := [Reading::Missing, Sample::Single(6)];
    // Matching an array element also borrows in place.
    let single := match readings[1] { Sample::Single(value) => value, _ => 0 };
    let batch := Reading::Batch([2, 3, 4], true);
    inspect(readings[0].borrow()) == 0 && single == 6
        && inspect(batch.borrow()) == 9 && take(batch) == 9
}

// References and a function-local Option<borrow T>.
fn read(value: borrow i32) -> i32 {
    value.copy()
}

fn optional_borrow() -> Bool {
    var owner := 7;
    var editor := owner.share(); // A stored mutable handle uses var.
    editor += 1;
    let saved := read(editor); // Reborrow the share for read-only access.
    // The share ended at its last use. The annotation supplies the borrow
    // payload type. Moving the wrapper transfers the handle and its loan.
    let wrapped: Option<borrow i32> = Some(owner.borrow());
    let moved := wrapped;
    let snapshot := match moved { Some(view) => read(view), None => 0 };
    owner = 9; // The consuming match and the last use of view release the loan.

    let empty: Option<borrow i32> = None;
    let fallback := match empty { Some(view) => view.copy(), None => owner };
    saved == 8 && snapshot == 8 && fallback == 9
}
// Borrow Options support direct annotations on immutable locals and consuming
// matches. Aliases, fields, nesting, signatures and branch results are gated.
// Reference returns, rebinding and loans of primitive projections such as
// row[0].borrow() are also outside the current subset.

// Owned outcomes and nominal errors.
type ReadingError: Error {
    pub station_id: u32,
}
type RangeError: ReadingError {
    observed: i32,
}
type Checked = Result<Row, RangeError>;
type Poll = Attempt<Option<i32>, RangeError>;

fn replace_context(context: share ReadingError) {
    // A whole write through an ancestor share updates its visible fields.
    // The descendant keeps its concrete type and its observed field.
    context = ReadingError { code: 12, station_id: 7 };
}

fn error_code(error: borrow Error) -> u32 {
    error.code
}

fn check(value: i32) -> Checked {
    if value < 0 {
        // Every inherited field needs an initializer, including Error.code.
        Err(RangeError { code: 1, station_id: 0, observed: value })
    } else {
        Ok([value, value + 1, value + 2])
    }
}

fn poll(enabled: Bool, value: i32) -> Poll {
    if !enabled { return Poll::Skipped; }
    match check(value) {
        Ok(row) => {
            // Some can infer an owned Option from its payload. Bare None
            // needs an expected type, here supplied by Poll::Done.
            if row[0] == 0 {
                Poll::Done(None)
            } else {
                let reading := Some(total(row.borrow()));
                Done(reading)
            }
        },
        Err(error) => Failed(error),
    }
}

fn outcomes() -> Bool {
    let done := match poll(true, 2) {
        Done(reading) => match reading { Some(value) => value == 9, None => false },
        _ => false,
    };
    // Done(None) means the operation ran and found no reading.
    let empty := match poll(true, 0) {
        Done(reading) => match reading { None => true, Some(_) => false },
        _ => false,
    };
    let skipped := match poll(false, 2) { Skipped => true, _ => false };
    let failed := match poll(true, -4) {
        Failed(error) => {
            var error := error;
            replace_context(error.share()); // RangeError to ReadingError.
            error_code(error.borrow()) == 12 // RangeError to its root Error.
                && error.station_id == 7 && error.observed == -4
        },
        _ => false,
    };
    done && empty && skipped && failed
}
// Ancestor reference conversion works at direct internal calls. Owned
// conversion to an ancestor is unavailable. Result and Attempt require Error
// or a nominal descendant as their error argument.

// Project features to try from the repository root:
// - examples/projects/numeric imports a public function via self::math and
//   exports it as add in project.toml. Use its manifest with mb resolve --lib,
//   mb build --lib, or mb build --output PATH.
// - examples/projects/structs imports a public type and uses public fields.
//   Imports support qualified paths and as aliases. Items and fields are
//   module-private by default. A manifest prelude can supply local names.
// - examples/projects/arrays and examples/projects/enums extend the aggregate
//   examples. examples/analysis has standalone analyze and ownership inputs.
// - crates/memobits-cli/README.md covers project, syntax, resolve, analyze,
//   ownership, analyze-project, ownership-project, build, and run. See it
//   for stack_size, fuel limits, and selecting a Wasm export with --entry.
//   The runner calls zero-argument exports. Library exports use scalar
//   signatures. External linking, type exports and mb check are unsupported.
// - examples/design/language-guide.mb explores target syntax. String slicing,
//   scalar iteration, lists, user-defined generics, try, defaults and
//   aggregate .copy() are gated.

// A zero-argument application entry can return Result or Attempt with a
// primitive success payload. Both runners show the variant and typed value
// or the concrete error type and code.
fn main() -> Result<i32, Error> {
    if !numbers() { return Err(Error { code: 1 }); }
    if !stations() { return Err(Error { code: 2 }); }
    if !enums() { return Err(Error { code: 3 }); }
    if !optional_borrow() { return Err(Error { code: 4 }); }
    if !outcomes() { return Err(Error { code: 5 }); }
    if !fixed_bytes() { return Err(Error { code: 6 }); }
    if !fixed_text() { return Err(Error { code: 7 }); }
    if !text_boundaries() { return Err(Error { code: 8 }); }
    if !text_bytes() { return Err(Error { code: 9 }); }
    if !text_scalars() { return Err(Error { code: 10 }); }
    let sample := "aé€😀";
    if !walk_text(sample.borrow()) { return Err(Error { code: 11 }); }
    if !text_concat() { return Err(Error { code: 12 }); }
    Ok(42)
}
