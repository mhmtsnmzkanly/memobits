// A Result<String, E> may be stored in a struct field or a fixed-array element
// while its Ok payload is a String literal. Heap Ok payloads are rejected
// there (TE018); they must be matched immediately as shown above.
type Outcome { text: Result<string, Error>, tag: u32 }

fn failure_code(items: Array<Result<string, Error>, 2>) -> u32 {
    match items[1] { Ok(_) => 0 as u32, Err(error) => error.code }
}

fn nested_result_storage() -> Bool {
    let ok: Result<string, Error> = Ok("é");
    let stored := Outcome { text: ok, tag: 3 };
    let failed: Result<string, Error> = Err(Error { code: 8 });
    let failed_outcome := Outcome { text: failed, tag: 4 };
    let from_field := match failed_outcome.text { Ok(_) => 0 as u32, Err(error) => error.code };
    let first: Result<string, Error> = Ok("x");
    let second: Result<string, Error> = Err(Error { code: 9 });
    let items := [first, second];
    stored.tag == 3 && from_field == 8 && failure_code(items) == 9
}

// Enums and exhaustive matching. An alias can also qualify variants.
type Reading [ Missing, Single(i32), Batch(Row, Bool) ]
type Sample = Reading;

fn inspect(sample: borrow Reading) -> i32 {
    // Borrow matching copies primitive payloads and lends aggregate payloads.
    match sample {
        Sample::Missing => 0,
        Sample::Single(value) => value,
        Sample::Batch(row, _) => total(row),
    }
}

fn take(sample: Reading) -> i32 {
    // Owned matching consumes the enum. Here row is an owned array.
    match sample {
        Reading::Batch(row, valid) => {
            if valid { total(row.borrow()) } else { 0 }
        },
        _ => 0, // A wildcard covers the remaining variants.
    }
}

fn enums() -> Bool {
    let readings := [Reading::Missing, Sample::Single(6)];
    // Matching an array element also borrows in place.
    let single := match readings[1] { Sample::Single(value) => value, _ => 0 };
    let batch := Reading::Batch([2, 3, 4], true);
    inspect(readings[0].borrow()) == 0 && single == 6
        && inspect(batch.borrow()) == 9 && take(batch) == 9
}

// Anonymous records use exact field-name/type shapes. Reordering fields does
// not change the shape, while initializer effects still run in written order.
fn record_total(value: { right: u32, left: u32 }) -> u32 {
    value.left + value.right
}
// An anonymous record that owns a String moves by value like a nominal struct:
// into owned internal arguments and results from a named local, into a struct
