// Start at main, then follow the checks. Both source and Wasm runs should
// print Result: Ok(i32(42)). Each error code identifies a failed check.
// For a source declaration that calls a typed host import, see
// ../../host-capability/README.md. It requires the CLI profile in project.toml;
// the current source ABI supports only write_i32(i32) -> unit.

/* Numbers and control flow. Block comments can /* nest */. */
// Character literals contain exactly one Unicode scalar. `Char` remains a
// distinct type from `u32`, though both use a 32-bit Wasm value.
fn character_roundtrip(value: Char) -> Bool { value == '😀' }
fn character_literals() -> Bool {
    let ascii: Char = 'A';
    let accented: Char = 'é';
    ascii == 'A' && accented == 'é' && character_roundtrip('😀')
        && '\n' == '\n' && '\\' == '\\' && '\'' == '\''
}

// Tuples preserve element order in local values and internal calls. Numeric
// projections use `.0`, `.1`; labels are occurrence-local projection aliases.
// Positional destructuring consumes every slot of a named tuple local,
// including direct owned String elements. Nested tuple patterns and `_`
// discards are supported; discarded String slots still receive normal cleanup.
// A temporary tuple with owned String slots can move into an owned internal
// call. Nested String-owning tuples can also move through tuple slots and
// internal signatures, and can be stored in local nominal record fields and
// fixed arrays. Array and tuple scope cleanup releases each owned String.
// Enums can own Strings, tuples, or fixed-array payloads, including nested
// String-owning tuples, and release only the active payload on a match or exit.
// String-owning nominal structs move by value as owned internal arguments and
// results, and nest in tuples, structs, enum payloads and fixed arrays (see
// `owned_string_struct_argument`). Destructuring aliases, partial
// destructuring, and moving a field or element out of a live owner remain
// unsupported.
type NestedTupleRecord { values: (string, string), count: u32 }
type TextState [ Texts((string, string), u32), Discarded((string, string), (string, string)), Empty ]
type TextBatch [ Rows(Array<(string, u32), 2>), Single((string, u32)), Plain(string), Empty ]
// Fixed arrays can contain scalar and String-owning tuples, and tuples can
// contain fixed arrays.
fn sum_string_rows(rows: Array<(string, u32), 2>) -> u32 {
    rows[0].1 + rows[1].1
}
fn consume_text_batches(batches: Array<TextBatch, 3>, early: Bool) -> Bool {
    if early { return false; }
    true
}
fn tuple_array_values() -> Bool {
    let rows: Array<(i32, Bool), 2> = [(40, false), (2, true)];
    let first := "first".concat("");
    let second := "second".concat("");
    let first_row: (string, u32) = (first, 20);
    let second_row: (string, u32) = (second, 22);
    let owned_rows: Array<(string, u32), 2> = [first_row, second_row];
    let third := "third".concat("");
    let fourth := "fourth".concat("");
    let fifth := "fifth".concat("");
    let sixth := "sixth".concat("");
    let batch_first: (string, u32) = (third, 20);
    let batch_second: (string, u32) = (fourth, 22);
    let batch_single: (string, u32) = (fifth, 7);
    let batch_plain: TextBatch = TextBatch::Plain(sixth);
    let batch_rows: Array<(string, u32), 2> = [batch_first, batch_second];
    let rows_state: TextBatch = TextBatch::Rows(batch_rows);
    let single_state: TextBatch = TextBatch::Single(batch_single);
    let batches: Array<TextBatch, 3> = [rows_state, single_state, batch_plain];
    let nested := (rows, 0);
    nested.0[1].1 && nested.0[0].0 + nested.0[1].0 + nested.1 == 42
        && sum_string_rows(owned_rows) == 42
        && consume_text_batches(batches, false)
}
fn echo_pair(pair: (i32, Bool)) -> (i32, Bool) { (pair.0, pair.1) }
fn labeled_left(pair: (left: i32, right: i32)) -> i32 { pair.left }
fn reversed_labeled_left(pair: (right: i32, left: i32)) -> i32 { pair.left }
fn forward_owned_pair(pair: (string, u32), early: Bool) -> (string, u32) {
    if early { return pair; }
    pair
}
fn consume_owned_texts(pair: (string, string, u32)) -> u32 {
    let (left, right, base) := pair;
    left.len() + right.len() + base
}
fn forward_nested_text(pair: ((string, string), u32)) -> ((string, string), u32) { pair }
fn consume_nested_text(pair: ((string, string), u32)) -> u32 {
    let ((left, right), base) := pair;
    left.len() + right.len() + base
}
fn owned_tuple_temporary_call() -> Bool {
    let left := "xy".concat("!");
    let right := "ab".concat("?");
    consume_owned_texts((left, right, 36 as u32)) == 42
}
fn nested_owned_tuple_temporary_call() -> Bool {
    let left := "ab".concat("");
    let right := "cd".concat("");
    let inner := (left, right);
    consume_nested_text(forward_nested_text((inner, 38 as u32))) == 42
}
fn nested_owned_tuple_record_field() -> Bool {
    let left := "ab".concat("");
    let right := "cd".concat("");
    let values := (left, right);
    let record := NestedTupleRecord { values: values, count: 38 as u32 };
    record.values.0.len() == 2 && record.values.1.len() == 2
        && record.count == 38
}
fn package_text_state(pair: (string, string), count: u32) -> TextState {
    TextState::Texts(pair, count)
}
fn consume_text_state(state: TextState) -> u32 {
    match state {
        TextState::Texts(pair, count) => {
            let (left, right) := pair;
            left.len() + right.len() + count
        },
        TextState::Discarded(pair, _) => {
            let (left, right) := pair;
            left.len() + right.len()
        },
        TextState::Empty => 0,
    }
}
fn early_text_state_exit(state: TextState, flag: Bool) -> u32 {
    if flag { return 1; }
    consume_text_state(state)
}
fn tuple_enum_payloads() -> Bool {
    let left := "ab".concat("");
    let right := "cd".concat("");
    let early := early_text_state_exit(package_text_state((left, right), 90 as u32), true);
    let first := "ab".concat("");
    let second := "cd".concat("");
    let a := "ab".concat("");
    let b := "cd".concat("");
    let c := "ef".concat("");
    let d := "gh".concat("");
    early + consume_text_state(package_text_state((first, second), 38 as u32)) == 43
        && consume_text_state(TextState::Discarded((a, b), (c, d))) == 4
}
fn tuple_values() -> Bool {
    let pair := echo_pair((40, true));
    let (number, enabled) := pair;
    let text := "owned".concat("!");
    let text_pair := (text, 40 as u32);
    let owned := forward_owned_pair(text_pair, true);
    // The returned tuple is first bound to `owned`, then fully destructured.
    let (owned_text, count) := owned;
    let discarded := "discarded".concat("!");
    let nested_owned := ((42, true), discarded);
    let ((nested_number, nested_enabled), _) := nested_owned;
    number == 40 && enabled
        && owned_tuple_temporary_call()
        && nested_owned_tuple_temporary_call()
        && nested_owned_tuple_record_field()
        && tuple_enum_payloads()
        && owned_text.len() == 6 && count == 40
        && nested_number == 42 && nested_enabled
        && tuple_array_values()
        && labeled_left((left: 40, right: 0))
            + reversed_labeled_left((right: 0, left: 2)) == 42
}

fn numbers() -> Bool {
    // An annotation supplies the literal type. Without context, integers
    // default to i32 and floats to f64.
    let a: i8 = -8;
    let b: i16 = -160;
    let c := 3_200;
    let d: i64 = 6_400;
    let e: u8 = 8;
    let f: u16 = 160;
    let g: u32 = 320;
    let h: u64 = 640;
    let half: f32 = 5e-1;
    let negative_half: f32 = -5e-1;
    let quarter := 0.25;

    // var permits assignment. let creates an immutable binding.
    var step := 0;
    var sum := 0;
    loop {
        step += 1;
        if step > 5 { break; }
        if step % 2 == 0 { continue; }
        sum += step;
    }
    // A new binding can shadow the old one. A tail expression yields a value.
    let sum := { let offset := 1; sum + offset };
    if !(sum == 10) { return false; }
    let divisor := step - 6;
    // Short-circuit evaluation skips the division when divisor is zero.
    if divisor == 0 || sum / divisor > 0 {
        a < 0 && b <= -160 && c >= 3_200 && d != 0
            && e * 2 == 16 && f - 10 == 150 && g / 2 == 160 && h % 3 == 1
            && half + 0.5 == 1.0 && negative_half == -0.5
            && quarter * 4.0 == 1.0
    } else {
        false
    }
}

// Numeric `as` casts are explicit across supported integer and float types.
// Integer casts keep low bits; float-to-int truncates and saturates, with NaN
// becoming zero. The byte convenience method is equivalent to `as u32`.
fn widen_byte(value: u8) -> u32 {
    value as u32
}
fn widen_byte_method(value: u8) -> u32 {
    value.to_u32()
}
fn widenings() -> Bool {
    let bytes: Array<u8, 4> = [0, 127, 128, 255];
    widen_byte(bytes[0]) == 0 && widen_byte_method(bytes[1]) == 127
        && bytes[2] as u32 == 128 && bytes[3].to_u32() == 255
}
fn numeric_casts() -> Bool {
    let all_bits: u32 = 4294967295;
    let signed: i32 = all_bits as i32;
    let fraction: i32 = (-1.9) as i32;
    let nan: u32 = (0.0 / 0.0) as u32;
    let saturated: u64 = 1e300 as u64;
    let rounded: u64 = 16777217 as f32 as u64;
    signed == -1 && fraction == -1 && nan == 0
        && saturated == 18446744073709551615 && rounded == 16777216
}
// Explicit u32 wrapping methods perform arithmetic modulo 2^32. Plain `+`
// and `*` keep their checked behavior.
fn wrapping_arithmetic() -> Bool {
    let max: u32 = 4294967295;
    max.wrapping_add(1) == 0 && max.wrapping_mul(2) == 4294967294
}
// u32 bitwise operations preserve the bit pattern. Shift counts must be below
// 32; left shift discards high bits and right shift fills with zeroes.
fn bit_operations() -> Bool {
    let high: u32 = 2147483648;
    let pattern: u32 = 2863311530;
    1 | 2 ^ 3 & 7 == 1 && pattern.bit_xor(1431655765) == 4294967295
        && pattern.bit_and(15) == 10 && pattern.bit_or(5) == 2863311535
        && 1 << 31 == high && high >> 31 == 1
}

// A direct share parameter can replace a String field. The caller retains
// ownership and cleanup; the callee only has exclusive access during the call.
type TextRecord { text: string, tag: u32 }
type Box<T> { value: T } extend {
    fn read_value(borrow self) -> T { self.value }
}
type Buffer<T, const N: u32> { data: Array<T, N> }
// Generic nominal methods may name nested instances of the receiver's type
// parameter, such as Twin<Nest<T>>. Bounded nesting specializes per receiver;
// unbounded polymorphic recursion stops at the 256-specialization diagnostic.
type Twin<T> { first: T, second: T }
type Nest<T> { value: T } extend {
    fn twin(borrow self) -> Twin<Nest<T>> {
        Twin<Nest<T>> { first: Nest<T> { value: self.value }, second: Nest<T> { value: self.value } }
    }
}
// A const parameter in scope can be forwarded as a nested type argument
// (Lane<N> inside a method of Gauge<const N: u32>). A method call on a field
// or element place (`self.lane.span()`, `gauges[0].span()`) addresses the place
// in place: `borrow self` reads it, `share self` needs a mutable owner and
// respects field-level loans, and an owned `self` would be a partial move.
type Lane<const N: u32> { width: i32 } extend {
    fn span(borrow self) -> i32 { self.width }
    fn widen(share self) { self.width += 1; }
}
type Gauge<const N: u32> { width: i32 } extend {
    fn lane(borrow self) -> Lane<N> { Lane<N> { width: self.width } }
}
type GaugePair { first: Lane<2>, second: Lane<3> }
type Maybe<T> [Empty, Present(T)]
type Packet<const N: u32> [Data(Array<u8, N>)]
// Inline anonymous enum declarations keep their nominal identity by source
// site; unit and payload variants can be selected by an expected type.
// Reference-bearing payloads are rejected; String payloads are supported
// (see the enum-array example).
type GuidePhase = enum [Ready, Waiting];
type OtherGuidePhase = enum [Ready, Waiting];
// Bodyless declarations preserve a nominal type identity but have no value
// constructor in this slice. An empty struct below remains a distinct type.
type EmptyRecord {}
// A trailing `extend` attaches methods to its nominal declaration; methods
// use ordinary receiver calls. Generic nominal methods specialize with their
// receiver, as Box<T>::read_value above demonstrates.
type OpaqueHandle; extend {
    fn opaque_kind(borrow self) -> Bool { true }
}
type Signal [Start, Stop] extend {
    fn is_active(borrow self) -> Bool {
        match self {
            Signal::Start => true,
            Signal::Stop => false,
        }
    }
}
type GuideCounter { value: i32 } extend {
    fn doubled(borrow self) -> i32 { self.value * 2 }
}
fn guide_counter() -> GuideCounter { GuideCounter { value: 21 } }
fn replace_record_text(record: share TextRecord) {
    record.text = "updated";
}
fn accept_opaque_handle(handle: OpaqueHandle) {}
fn shared_string_field_replacement() -> Bool {
    var record := TextRecord { text: "before", tag: 7 };
    replace_record_text(record.share());
    record.text.len() == 7 && record.tag == 7
}

// Generic functions specialize one unconstrained type parameter inferred from
// a direct owned argument. Additional parameters may use that same T or fixed
// concrete types; the result is T. A bounded const form forwards T and N only
// through direct Array<T, N> parameters and results. Each body is checked for
// its concrete specialization. A single interface bound on direct owned T
// carries caller-visible evidence through nested generic calls and constrained
// compound assignment. Other bound shapes, borrowed parameters, and nested
// generic type patterns remain gated.
fn identity<T>(value: T) -> T { value }
fn select<T>(value: T, enabled: Bool, fallback: T) -> T {
    if enabled { value } else { fallback }
}
fn generic_functions() -> Bool {
    let number := 40;
    let selected: i32 = select(number, true, 0);
    let flag: Bool = identity(true);
    let again: i32 = identity(selected);
    flag && again + identity(2) == 42
}
fn echo_array<T, const N: u32>(value: Array<T, N>) -> Array<T, N> { value }
fn relay_array<T, const N: u32>(value: Array<T, N>) -> Array<T, N> {
    echo_array(value)
}
fn generic_array_forwarding() -> Bool {
    let one: Array<i32, 1> = [40];
    let two: Array<i32, 2> = [1, 1];
    let first := relay_array(one);
    let second := relay_array(two);
    first[0] + second[0] + second[1] == 42
}

// A generic bound uses the caller-visible interface implementation. A nested
// generic call forwards that selected evidence to the constrained function.
type RenderPoint { value: i32 }
interface Render { fn render(borrow self) -> i32; }
extend RenderPoint of Render {
    fn render(borrow self) -> i32 { self.value }
}
fn render_value<T>(value: T) -> i32 where T: Render {
    value.render() of Render
}
fn relay_render<T>(value: T) -> i32 where T: Render {
    render_value(value)
}
fn generic_interface_forwarding() -> Bool {
    let point := RenderPoint { value: 42 };
    relay_render(point) == 42
}

// User-defined + selects the compiler-provided core::ops::Add interface.
// Associated Rhs and Output permit a heterogeneous owned operation. Generic
// signatures project both types through the caller-selected Add evidence;
// primitive arithmetic remains checked and built in.
use core::ops::Add;
type AddPoint { value: i32 }
type AddRight { value: i32 }
type AddResult { value: i32 }
extend AddPoint of Add {
    type Rhs = AddRight;
    type Output = AddResult;
    fn add(self, rhs: AddRight) -> AddResult {
        AddResult { value: self.value + rhs.value }
    }
}
fn add_points<T>(left: T, right: T::Rhs) -> T::Output where T: Add {
    left + right
}
fn user_defined_add() -> Bool {
    let left := AddPoint { value: 20 };
    let right := AddRight { value: 22 };
    let total := add_points(left, right);
    total.value == 42
}

// User-defined - follows the same owned associated-type contract through
// core::ops::Sub. Primitive subtraction stays built in and checked.
use core::ops::Sub;
type SubLeft { value: i32 }
type SubRight { value: i32 }
type SubResult { value: i32 }
extend SubLeft of Sub {
    type Rhs = SubRight;
    type Output = SubResult;
    fn sub(self, rhs: SubRight) -> SubResult {
        SubResult { value: self.value - rhs.value }
    }
}
fn subtract<T>(left: T, right: T::Rhs) -> T::Output where T: Sub {
    left - right
}
fn user_defined_sub() -> Bool {
    let difference := subtract(SubLeft { value: 50 }, SubRight { value: 8 });
    difference.value == 42
}

// User-defined * uses the owned associated-type contract through Mul.
use core::ops::Mul;
type MulLeft { value: i32 }
type MulRight { value: i32 }
type MulResult { value: i32 }
extend MulLeft of Mul {
    type Rhs = MulRight;
    type Output = MulResult;
    fn mul(self, rhs: MulRight) -> MulResult {
        MulResult { value: self.value * rhs.value }
    }
}
fn multiply<T>(left: T, right: T::Rhs) -> T::Output where T: Mul {
    left * right
}
fn user_defined_mul() -> Bool {
    let product := multiply(MulLeft { value: 6 }, MulRight { value: 7 });
    product.value == 42
}

// User-defined / uses the owned associated-type contract through Div.
use core::ops::Div;
type DivLeft { value: i32 }
type DivRight { value: i32 }
type DivResult { value: i32 }
extend DivLeft of Div {
    type Rhs = DivRight;
    type Output = DivResult;
    fn div(self, rhs: DivRight) -> DivResult {
        DivResult { value: self.value / rhs.value }
    }
}
fn divide<T>(left: T, right: T::Rhs) -> T::Output where T: Div {
    left / right
}
fn user_defined_div() -> Bool {
    let quotient := divide(DivLeft { value: 84 }, DivRight { value: 2 });
    quotient.value == 42
}

// User-defined % uses the same owned associated-type contract through Rem.
use core::ops::Rem;
type RemLeft { value: i32 }
type RemRight { value: i32 }
type RemResult { value: i32 }
extend RemLeft of Rem {
    type Rhs = RemRight;
    type Output = RemResult;
    fn rem(self, rhs: RemRight) -> RemResult {
        RemResult { value: self.value % rhs.value }
    }
}
fn remainder<T>(left: T, right: T::Rhs) -> T::Output where T: Rem {
    left % right
}
fn user_defined_rem() -> Bool {
    let result := remainder(RemLeft { value: 43 }, RemRight { value: 7 });
    result.value == 1
}

// User-defined & selects BitAnd for nominal operands. Primitive u32 `&`
// keeps its existing per-bit operation.
use core::ops::BitAnd;
type MaskLeft { value: u32 }
type MaskRight { value: u32 }
type MaskResult { value: u32 }
extend MaskLeft of BitAnd {
    type Rhs = MaskRight;
    type Output = MaskResult;
    fn bitand(self, rhs: MaskRight) -> MaskResult {
        MaskResult { value: self.value & rhs.value }
    }
}
fn mask<T>(lhs: T, operand: T::Rhs) -> T::Output where T: BitAnd {
    lhs & operand
}
fn user_defined_bitand() -> Bool {
    let lhs := MaskLeft { value: 12 };
    let operand := MaskRight { value: 10 };
    let result := mask(lhs, operand);
    result.value == 8
}

// User-defined | selects BitOr for nominal operands. Primitive u32 `|`
// remains the built-in per-bit operation.
use core::ops::BitOr;
type MergeLeft { value: u32 }
type MergeRight { value: u32 }
type MergeResult { value: u32 }
extend MergeLeft of BitOr {
    type Rhs = MergeRight;
    type Output = MergeResult;
    fn bitor(self, rhs: MergeRight) -> MergeResult {
        MergeResult { value: self.value | rhs.value }
    }
}
fn merge<T>(lhs: T, operand: T::Rhs) -> T::Output where T: BitOr {
    lhs | operand
}
fn user_defined_bitor() -> Bool {
    let lhs := MergeLeft { value: 12 };
    let operand := MergeRight { value: 10 };
    let result := merge(lhs, operand);
    result.value == 14
}

// User-defined ^ selects BitXor for nominal operands. Primitive u32 `^`
// keeps its existing per-bit operation.
use core::ops::BitXor;
type XorLeft { value: u32 }
type XorRight { value: u32 }
type XorResult { value: u32 }
extend XorLeft of BitXor {
    type Rhs = XorRight;
    type Output = XorResult;
    fn bitxor(self, rhs: XorRight) -> XorResult {
        XorResult { value: self.value ^ rhs.value }
    }
}
fn xor<T>(lhs: T, operand: T::Rhs) -> T::Output where T: BitXor {
    lhs ^ operand
}
fn user_defined_bitxor() -> Bool {
    let result := xor(XorLeft { value: 12 }, XorRight { value: 10 });
    result.value == 6
}

// User-defined unary minus selects Neg for nominal values. The receiver is
// owned, and Output may differ from the input type.
use core::ops::Neg;
type NegInput { value: i32 }
type NegResult { value: i32 }
extend NegInput of Neg {
    type Output = NegResult;
    fn neg(self) -> NegResult { NegResult { value: 0 - self.value } }
}
fn negate<T>(value: T) -> T::Output where T: Neg { -value }
fn user_defined_negation() -> Bool {
    let result := negate(NegInput { value: 42 });
    result.value == -42
}

// Nominal equality borrows its left receiver and consumes the right operand.
use core::ops::PartialEq;
type EqKey { value: u32 }
extend EqKey of PartialEq {
    type Rhs = EqKey;
    fn eq(borrow self, rhs: EqKey) -> Bool { self.value == rhs.value }
}
fn user_defined_equality() -> Bool {
    let left := EqKey { value: 12 };
    let same := EqKey { value: 12 };
    let different := EqKey { value: 13 };
    let equal := left == same;
    let not_equal := left != different;
    equal && not_equal && left.value == 12
}

// Nominal ordering selects the matching PartialOrd member directly.
use core::ops::PartialOrd;
type OrderedKey { value: u32 }
extend OrderedKey of PartialOrd {
    type Rhs = OrderedKey;
    fn lt(borrow self, rhs: OrderedKey) -> Bool { self.value < rhs.value }
    fn le(borrow self, rhs: OrderedKey) -> Bool { self.value <= rhs.value }
    fn gt(borrow self, rhs: OrderedKey) -> Bool { self.value > rhs.value }
    fn ge(borrow self, rhs: OrderedKey) -> Bool { self.value >= rhs.value }
}
fn ordered_before<T>(left: T, right: T::Rhs) -> Bool where T: PartialOrd { left < right }
fn user_defined_ordering() -> Bool {
    let left := OrderedKey { value: 12 };
    let right := OrderedKey { value: 13 };
    let same := OrderedKey { value: 12 };
    let lower := OrderedKey { value: 11 };
    let lower_again := OrderedKey { value: 11 };
    let higher := OrderedKey { value: 13 };
    let same_again := OrderedKey { value: 12 };
    let one := OrderedKey { value: 1 };
    let two := OrderedKey { value: 2 };
    left < right && left <= same && higher > lower && left >= lower_again && left >= same_again
        && ordered_before(one, two)
        && left.value == 12
}

// Nominal += selects AddAssign with a shared mutable place and owned RHS.
use core::ops::AddAssign;
type Tally { value: u32 }
type TallyDelta { value: u32 }
extend Tally of AddAssign {
    type Rhs = TallyDelta;
    fn add_assign(share self, rhs: TallyDelta) { self.value += rhs.value; }
}
fn generic_add_assign<T>(target: T, rhs: T::Rhs) -> T where T: AddAssign {
    var value := target;
    value += rhs;
    value
}
fn user_defined_add_assign() -> Bool {
    var tally := Tally { value: 7 };
    tally += TallyDelta { value: 5 };
    let generic := generic_add_assign(Tally { value: 10 }, TallyDelta { value: 2 });
    var primitive: u32 = 7;
    primitive += 5;
    tally.value == 12 && generic.value == 12 && primitive == 12
}

// Nominal -= selects SubAssign with a shared mutable place and owned Rhs.
// Primitive numeric -= keeps its existing checked arithmetic behavior.
use core::ops::SubAssign;
type Balance { value: u32 }
type BalanceDelta { value: u32 }
extend Balance of SubAssign {
    type Rhs = BalanceDelta;
    fn sub_assign(share self, rhs: BalanceDelta) { self.value -= rhs.value; }
}
fn generic_sub_assign<T>(target: T, rhs: T::Rhs) -> T where T: SubAssign {
    var value := target;
    value -= rhs;
    value
}
fn user_defined_sub_assign() -> Bool {
    var balance := Balance { value: 19 };
    balance -= BalanceDelta { value: 7 };
    let generic := generic_sub_assign(Balance { value: 20 }, BalanceDelta { value: 8 });
    var primitive: u32 = 19;
    primitive -= 7;
    balance.value == 12 && generic.value == 12 && primitive == 12
}

// Nominal *= selects MulAssign with a shared mutable place and owned Rhs.
// Primitive numeric *= keeps its existing checked arithmetic behavior.
use core::ops::MulAssign;
type Scale { value: u32 }
type ScaleFactor { value: u32 }
extend Scale of MulAssign {
    type Rhs = ScaleFactor;
    fn mul_assign(share self, rhs: ScaleFactor) { self.value *= rhs.value; }
}
fn generic_mul_assign<T>(target: T, rhs: T::Rhs) -> T where T: MulAssign {
    var value := target;
    value *= rhs;
    value
}
fn user_defined_mul_assign() -> Bool {
    var scale := Scale { value: 6 };
    scale *= ScaleFactor { value: 7 };
    let generic := generic_mul_assign(Scale { value: 6 }, ScaleFactor { value: 7 });
    var primitive: u32 = 6;
    primitive *= 7;
    scale.value == 42 && generic.value == 42 && primitive == 42
}

// Nominal /= selects DivAssign with a shared mutable place and owned Rhs.
// Primitive numeric /= retains checked integer division behavior.
use core::ops::DivAssign;
type Portion { value: u32 }
type PortionDelta { value: u32 }
extend Portion of DivAssign {
    type Rhs = PortionDelta;
    fn div_assign(share self, rhs: PortionDelta) { self.value /= rhs.value; }
}
fn generic_div_assign<T>(target: T, rhs: T::Rhs) -> T where T: DivAssign {
    var value := target;
    value /= rhs;
    value
}
fn user_defined_div_assign() -> Bool {
    var portion := Portion { value: 24 };
    portion /= PortionDelta { value: 3 };
    let generic := generic_div_assign(Portion { value: 81 }, PortionDelta { value: 3 });
    var primitive: u32 = 48;
    primitive /= 4;
    portion.value == 8 && generic.value == 27 && primitive == 12
}

// Nominal %= selects RemAssign with a shared mutable place and owned Rhs.
// Primitive remainder stays checked, including zero and signed overflow rules.
use core::ops::RemAssign;
type Remainder { value: u32 }
type Modulus { value: u32 }
type RemainderHolder { items: Array<Remainder, 1> }
extend Remainder of RemAssign {
    type Rhs = Modulus;
    fn rem_assign(share self, rhs: Modulus) { self.value %= rhs.value; }
}
fn generic_rem_assign<T>(target: T, rhs: T::Rhs) -> T where T: RemAssign {
    var value := target;
    value %= rhs;
    value
}
fn generic_rem_array_assign<T, const N: u32>(var values: Array<T, N>, index: u32, rhs: T::Rhs) -> Array<T, N>
    where T: RemAssign {
    values[index] %= rhs;
    values
}
fn generic_rem_projected_assign<T>(var holder: RemainderHolder, witness: T, rhs: T::Rhs) -> RemainderHolder
    where T: RemAssign {
    holder.items[0] %= rhs;
    holder
}
fn user_defined_rem_assign() -> Bool {
    var remainder := Remainder { value: 23 };
    let modulus := Modulus { value: 5 };
    remainder %= modulus;
    let generic := generic_rem_assign(Remainder { value: 23 }, Modulus { value: 5 });
    let indexed := generic_rem_array_assign([Remainder { value: 23 }], 0, Modulus { value: 5 });
    remainder.value == 3 && generic.value == 3 && indexed[0].value == 3
}

// Nominal &= selects BitAndAssign with a shared mutable place and owned Rhs.
use core::ops::BitAndAssign;
type PermissionBits { value: u32 }
type PermissionMask { value: u32 }
extend PermissionBits of BitAndAssign {
    type Rhs = PermissionMask;
    fn bitand_assign(share self, rhs: PermissionMask) { self.value &= rhs.value; }
}
fn generic_bitand_assign<T>(target: T, rhs: T::Rhs) -> T where T: BitAndAssign {
    var value := target;
    value &= rhs;
    value
}
fn user_defined_bitand_assign() -> Bool {
    var permissions := PermissionBits { value: 15 };
    let mask := PermissionMask { value: 6 };
    permissions &= mask;
    let generic := generic_bitand_assign(PermissionBits { value: 15 }, PermissionMask { value: 6 });
    permissions.value == 6 && generic.value == 6
}

// Nominal |= selects BitOrAssign and keeps the same single-evaluation place rules.
use core::ops::BitOrAssign;
type FeatureBits { value: u32 }
type FeatureMask { value: u32 }
extend FeatureBits of BitOrAssign {
    type Rhs = FeatureMask;
    fn bitor_assign(share self, rhs: FeatureMask) { self.value |= rhs.value; }
}
fn generic_bitor_assign<T>(target: T, rhs: T::Rhs) -> T where T: BitOrAssign {
    var value := target;
    value |= rhs;
    value
}
fn user_defined_bitor_assign() -> Bool {
    var features := FeatureBits { value: 8 };
    let mask := FeatureMask { value: 3 };
    features |= mask;
    let generic := generic_bitor_assign(FeatureBits { value: 8 }, FeatureMask { value: 3 });
    features.value == 11 && generic.value == 11
}

// Nominal ^= selects BitXorAssign; primitive u32 keeps per-bit XOR behavior.
use core::ops::BitXorAssign;
type FeatureDelta { value: u32 }
extend FeatureBits of BitXorAssign {
    type Rhs = FeatureDelta;
    fn bitxor_assign(share self, rhs: FeatureDelta) { self.value ^= rhs.value; }
}
fn generic_bitxor_assign<T>(target: T, rhs: T::Rhs) -> T where T: BitXorAssign {
    var value := target;
    value ^= rhs;
    value
}
fn user_defined_bitxor_assign() -> Bool {
    var features := FeatureBits { value: 10 };
    let delta := FeatureDelta { value: 3 };
    features ^= delta;
    let generic := generic_bitxor_assign(FeatureBits { value: 10 }, FeatureDelta { value: 3 });
    features.value == 9 && generic.value == 9
}

// User-defined << selects Shl for nominal operands. Primitive u32 shifts
// reject counts at or above 32, statically or at runtime.
use core::ops::Shl;
type ShiftLeft { value: u32 }
type ShiftCount { value: u32 }
type ShiftResult { value: u32 }
extend ShiftLeft of Shl {
    type Rhs = ShiftCount;
    type Output = ShiftResult;
    fn shl(self, rhs: ShiftCount) -> ShiftResult {
        ShiftResult { value: self.value << rhs.value }
    }
}
fn shift<T>(lhs: T, count: T::Rhs) -> T::Output where T: Shl {
    lhs << count
}
fn user_defined_shl() -> Bool {
    let result := shift(ShiftLeft { value: 3 }, ShiftCount { value: 4 });
    result.value == 48
}

// Nominal <<= selects ShlAssign with the same checked place sequencing.
use core::ops::ShlAssign;
extend ShiftLeft of ShlAssign {
    type Rhs = ShiftCount;
    fn shl_assign(share self, rhs: ShiftCount) { self.value <<= rhs.value; }
}
fn generic_shl_assign<T>(target: T, rhs: T::Rhs) -> T where T: ShlAssign {
    var value := target;
    value <<= rhs;
    value
}
fn user_defined_shl_assign() -> Bool {
    var value := ShiftLeft { value: 3 };
    let count := ShiftCount { value: 4 };
    value <<= count;
    let generic := generic_shl_assign(ShiftLeft { value: 3 }, ShiftCount { value: 4 });
    var primitive: u32 = 3;
    primitive <<= 4;
    value.value == 48 && generic.value == 48 && primitive == 48
}

// Nominal >>= uses ShrAssign; primitive u32 counts must be below 32.
use core::ops::ShrAssign;
extend ShiftRight of ShrAssign {
    type Rhs = ShiftAmount;
    fn shr_assign(share self, rhs: ShiftAmount) { self.value >>= rhs.value; }
}
fn generic_shr_assign<T>(target: T, rhs: T::Rhs) -> T where T: ShrAssign {
    var value := target;
    value >>= rhs;
    value
}
fn user_defined_shr_assign() -> Bool {
    var value := ShiftRight { value: 48 };
    let count := ShiftAmount { value: 2 };
    value >>= count;
    var primitive: u32 = 48;
    primitive >>= 2;
    let generic := generic_shr_assign(ShiftRight { value: 48 }, ShiftAmount { value: 2 });
    value.value == 12 && primitive == 12 && generic.value == 12
}

// A single generic bound forwards selected assignment evidence through owned
// locals, indexed Array<T, N> elements and a field-then-index projected place.
fn generic_compound_assignments() -> Bool {
    let remainder := generic_rem_assign(Remainder { value: 23 }, Modulus { value: 5 });
    let remainder_items := generic_rem_array_assign(
        [Remainder { value: 23 }, Remainder { value: 19 }], 1, Modulus { value: 7 }
    );
    let remainder_holder := generic_rem_projected_assign(
        RemainderHolder { items: [Remainder { value: 23 }] }, Remainder { value: 0 }, Modulus { value: 5 }
    );
    let permissions := generic_bitand_assign(
        PermissionBits { value: 15 }, PermissionMask { value: 6 }
    );
    let features_or := generic_bitor_assign(FeatureBits { value: 8 }, FeatureMask { value: 3 });
    let features_xor := generic_bitxor_assign(FeatureBits { value: 10 }, FeatureDelta { value: 3 });
    let shifted := generic_shl_assign(ShiftLeft { value: 3 }, ShiftCount { value: 4 });
    remainder.value == 3 && remainder_items[1].value == 5 && remainder_holder.items[0].value == 3
        && permissions.value == 6 && features_or.value == 11
        && features_xor.value == 9 && shifted.value == 48
}

// User-defined >> selects Shr and may use a distinct RHS type.
use core::ops::Shr;
type ShiftRight { value: u32 }
type ShiftAmount { value: u32 }
type Shifted { value: u32 }
extend ShiftRight of Shr {
    type Rhs = ShiftAmount;
    type Output = Shifted;
    fn shr(self, rhs: ShiftAmount) -> Shifted {
        Shifted { value: self.value >> rhs.value }
    }
}
fn shift_right<T>(lhs: T, count: T::Rhs) -> T::Output where T: Shr {
    lhs >> count
}
fn user_defined_shr() -> Bool {
    let result := shift_right(ShiftRight { value: 48 }, ShiftAmount { value: 2 });
    result.value == 12
}

fn nested_generic_methods() -> Bool {
    let signed := Nest<i32> { value: 40 };
    let unsigned := Nest<u32> { value: 2 };
    let pair := signed.twin();
    let other := unsigned.twin();
    let gauge := Gauge<3> { width: 40 }.lane();
    var pair_lanes := GaugePair { first: Lane<2> { width: 1 }, second: gauge };
    let first_view := pair_lanes.first.borrow();
    pair_lanes.second.widen();
    pair.first.value + pair.second.value == 80 && other.second.value == 2
        && first_view.span() == 1 && pair_lanes.second.span() == 41
}

// Generic nominal structs and enums specialize by type arguments. Const
// arguments substitute into admitted fixed-array fields. Enum construction
// uses the expected concrete enum type.
fn generic_structs() -> Bool {
    let signed := Box<i32> { value: 41 };
    let unsigned := Box<u32> { value: 42 };
    let bytes := Buffer<u8, 2> { data: [0, 42] };
    let maybe_i32: Maybe<i32> = Maybe::Present(42);
    let maybe_u32: Maybe<u32> = Maybe::Empty;
    let packet_one: Packet<1> = Packet::Data([1]);
    let packet_two: Packet<2> = Packet::Data([20, 21]);
    let unwrapped := match maybe_i32 {
        Maybe::Present(value) => value,
        Maybe::Empty => 0,
    };
    let empty := match maybe_u32 {
        Maybe::Present(_) => false,
        Maybe::Empty => true,
    };
    let packet_values := match packet_one {
        Packet::Data(bytes) => bytes[0] as i32,
    } + match packet_two {
        Packet::Data(bytes) => bytes[0] as i32 + bytes[1] as i32,
    };
    signed.read_value() + 1 == 42 && unsigned.read_value() == 42 && bytes.data[1] == 42
        && unwrapped == 42 && empty && packet_values == 42
}
fn trailing_enum_extension() -> Bool {
    let signal := Signal::Start;
    signal.is_active()
}
// Postfix `T?` is the preferred spelling of an optional type. The legacy
// `Option<T>` spelling is still accepted silently with identical meaning;
// this guide uses `T?` throughout. Grouping matters for
// references: `(borrow T)?` is an optional borrow, while `borrow T?` borrows
// an optional value. Contextual Some and None construction keeps the existing
// Option representation and match behavior.
fn optional_sugar() -> Bool {
    let present: i32? = Some(40);
    let absent: i32? = None;
    (match present {
        Some(value) => value == 40,
        None => false,
    }) && (match absent {
        Some(_) => false,
        None => true,
    })
}
// Integer arithmetic and array indexing are checked. Proven invalid cases
// can fail compilation. Dynamic overflow, zero divisors and invalid indices
// trap at runtime. Floats use IEEE arithmetic.

// Fixed arrays, structs, and ownership.
type Row = Array<i32, 3>;
type Station {
    id: u32,
    readings: Row,
}

fn station(id: u32) -> Station {
    // Every field must be initialized. The order here can differ from the type.
    Station { readings: [0; 3], id: id }
}

fn record(row: share Row, index: i32, reading: i32) {
    // share grants exclusive write access. The caller sees the update.
    row[index] = reading;
    return;
}

fn total(row: borrow Row) -> i32 {
    // borrow grants read-only access. Primitive values copy implicitly;
    // .copy() makes the same read explicit.
    let first := row[0];
    first + row[1].copy() + row[2]
}

fn calibrate(var row: Row) -> Row {
    // An owned parameter takes the caller's array. var lets this function edit it.
    row[0] -= 1;
    row[1] *= 2;
    row[2] /= 2;
    row[2] %= 3;
    row
}

fn stations() -> Bool {
    // Repetition calls station once per element.
    var pair := [station(7); 2];
    pair[0].readings = [4, 5, 8];
    let left := pair[0].borrow();
    // Constant indices 0 and 1 are disjoint. A dynamic index can overlap both.
    record(pair[1].readings.share(), 2, 9);
    let before := total(left.readings.borrow());
    pair[0] = station(8); // The loan ended at the last use of left.

    var sample := station(7);
    sample.readings = if before == 17 { [4, 5, 8] } else { [0; 3] };
    let readings := sample.readings.borrow();
    sample.id = 8; // A different field is also disjoint.
    let recorded := total(readings);
    let moved := sample; // Moving an aggregate consumes its old binding.
    let Station { id, readings: row } := moved;
    // Destructuring consumes the whole struct. Moving a single aggregate
    // field or element out of its owner is unsupported.
    let adjusted := calibrate(row);
    let grid := [[1, 2, 3], adjusted];
    id == 8 && recorded == 17 && total(grid[1].borrow()) == 14
        && pair[1].readings[2] == 9
}

// Array<u8, N> is the core fixed-byte representation. Bytes<N> remains a
// compatibility alias outside the target core.
fn set_first_byte(buffer: share Array<u8, 2>) {
    buffer[0] = 42;
}

fn first_byte(buffer: borrow Array<u8, 2>) -> u8 {
    buffer[0]
}

fn return_bytes(buffer: Array<u8, 2>) -> Array<u8, 2> {
    buffer
}

fn fixed_bytes() -> Bool {
    var bytes: Array<u8, 2> = [0; 2];
    set_first_byte(bytes.share());
    let array: Array<u8, 2> = return_bytes(bytes); // Moves the whole buffer.
    // Validation borrows the prefix and returns its Unicode scalar count.
    // The utf8-validator project checks malformed bytes and error offsets.
    let valid := match array.validate_utf8(1) {
        Ok(count) => count == 1,
        Err(_) => false
    };
    // Construction copies just the validated prefix into an owned String.
    let copied := match array.to_utf8_string(1) {
        Ok(text) => text.len() == 1 && byte_is(text.byte_at(0), 42),
        Err(_) => false
    };
    // contains and index_of read without moving the array. Numeric and Bool
    // arrays use == for comparisons, including nested rows.
    // index_of returns the first zero-based match, or None for a miss.
    let first := match [0, 42, 42].index_of(42) {
        Some(index) => index == 1,
        None => false
    };
    valid && copied && first && array.contains(42) && !array.contains(255)
        && first_byte(array.borrow()) == 42
}

// Fixed arrays iterate in index order. Each iteration binds an immutable
// primitive copy. The read loan ends when the loop exits.
fn fixed_iteration() -> Bool {
    var bytes: Array<u8, 4> = [1, 0, 3, 9];
    var digits: u8 = 0;
    loop byte in bytes {
        if byte == 0 { continue; }
        if byte == 9 { break; }
        digits = digits * 10 + byte;
    }
    bytes[0] = 7;

    let empty: Array<Bool, 0> = [];
    loop flag in empty { return flag; }
    digits == 13 && bytes[0] == 7
}

fn list_word_at(items: borrow List<u32>, index: u32) -> u32? {
    items.get(index)
}

fn list_has_word(items: borrow List<u32>, value: u32) -> Bool {
    items.contains(value)
}

fn append_word(items: share List<u32>, value: u32) {
    items.push(value);
}

fn owned_list_length(items: List<u32>) -> u32 {
    items.len()
}

fn make_words(first: u32) -> List<u32> {
    var words: List<u32> = [];
    words.push(first);
    words
}

fn replace_words(items: share List<u32>, value: u32) {
    items = make_words(value);
}

// List iteration visits immutable copies in insertion order. An empty List
// skips the body. A direct call result stays alive until the loop exits.
// The read loan prevents writes and moves of the receiver during the body.
fn list_iteration() -> Bool {
    var bytes: List<u8> = [];
    loop value in bytes { return false; }
    bytes.push(9);
    bytes.push(4);
    bytes.push(2);
    var digits: u8 = 0;
    loop value in bytes {
        if value == 9 { continue; }
        digits = digits * 10 + value;
    }
    bytes.clear();

    var first: u32 = 0;
    loop value in make_words(1000) {
        first = value;
        break;
    }
    digits == 42 && bytes.len() == 0 && first == 1000
}

// drop consumes a whole named owned String, List<u8>, or List<u32>.
// A mutable binding can be assigned again. A loan must end before drop.
// A user binding or function named drop takes precedence.
fn explicit_drop() -> Bool {
    let text := "release".concat(" me");
    var bytes: List<u8> = [];
    bytes.push(42);
    let words := make_words(1000);
    drop(text);
    drop(bytes);
    drop(words);
    bytes = [];
    bytes.push(7);
    bytes.len() == 1 && bytes.contains(7)
}

type TextLabel {
    number: u32,
    text: string,
}

// A local struct can own a literal-backed String alongside primitive fields.
// Read the field by borrowing it and move the whole struct to transfer it.
// Scope exit needs no deallocation. The frame is reclaimed on return, and
// literal bytes live in static memory.
// Use straight-line literal field initializers.
fn local_string_fields() -> Bool {
    var label := TextLabel { text: "é", number: 42 };
    {
        let moved := label;
        if !byte_is(moved.text.byte_at(0), 195) || moved.number != 42 {
            return false;
        }
        if byte_length(moved.text.borrow()) != 2 { return false; }
    };
    label = TextLabel { number: 7, text: "" };
    label.number == 7 && label.text.len() == 0
}

// Move a named heap String into a new local struct, then move the whole
// struct into another local. The final owner releases the String at scope exit.
// Borrow the field to read it. Wasm gates temporary String initializers,
// escaping or replacing a whole heap-owning struct, nesting, and returning
// the struct. A flat struct can be passed and returned by value; see
// `owned_string_struct_argument`.
fn local_heap_string_fields() -> Bool {
    let text := "é".concat("!");
    let label := TextLabel { number: 9, text: text };
    {
        let moved := label;
        moved.number == 9 && moved.text.len() == 3
            && byte_is(moved.text.byte_at(2), 33)
    }
}

// A flat struct whose fields are Strings and primitives moves into an owned
// internal parameter from a named local. The callee owns it and releases the
// String at its exit, on an early return too. The caller cannot use the moved
// local afterwards. A function can also return such a struct by moving a named
// local; bind the call result to a new local (`let label := make_label();`).
// Such a struct can also be a tuple element or a fixed-array element when it
// moves in from a named local (see `string_struct_elements`), a field of another
// String-owning struct, or an enum payload (see `nested_string_owners`).
// Temporaries as arguments or call results, `[l; N]` repeats, recursive
// by-value types, exported signatures, and moving a field, element or payload
// out of a live owner stay rejected.
fn label_total(label: TextLabel, early: Bool) -> u32 {
    if early { return 1; }
    label.number + label.text.len()
}

fn make_label(number: u32) -> TextLabel {
    let heap := "é".concat("!");
    let label := TextLabel { number: number, text: heap };
    label
}

fn owned_string_struct_argument() -> Bool {
    let heap := "é".concat("!");
    let first := TextLabel { number: 9, text: heap };
    let second := TextLabel { number: 5, text: "ab" };
    let spare_heap := "é".concat("!");
    let spare := TextLabel { number: 0, text: spare_heap };
    label_total(first, false) == 12 && label_total(second, false) == 7
        && label_total(spare, true) == 1
        && owned_string_struct_result()
        && string_struct_elements()
        && nested_string_owners()
}

fn label_pair_total(labels: Array<TextLabel, 2>, early: Bool) -> u32 {
    if early { return 1; }
    label_total_borrowed(labels[0].borrow()) + label_total_borrowed(labels[1].borrow())
}

fn label_total_borrowed(label: borrow TextLabel) -> u32 {
    label.number + label.text.len()
}

fn label_row_total(row: borrow (TextLabel, u32)) -> u32 {
    row.0.number + row.0.text.len() + row.1
}

// Elements are read through a borrow of the element or of the whole tuple.
// Scope exit releases the Strings, and the array moves into an owned call.
fn string_struct_elements() -> Bool {
    let first_heap := "é".concat("!");
    let first := TextLabel { number: 9, text: first_heap };
    let second := TextLabel { number: 5, text: "ab" };
    let pair := [first, second];
    let direct := label_total_borrowed(pair[0].borrow());
    let row_heap := "é".concat("!");
    let row_label := TextLabel { number: 1, text: row_heap };
    let row: (TextLabel, u32) = (row_label, 2);
    let spare_heap := "é".concat("!");
    let spare_first := TextLabel { number: 0, text: spare_heap };
    let spare_second := TextLabel { number: 0, text: "" };
    let spare := [spare_first, spare_second];
    direct == 12 && label_row_total(row.borrow()) == 6
        && label_pair_total(pair, false) == 19 && label_pair_total(spare, true) == 1
}

type NestedLabel {
    label: TextLabel,
    extra: u32,
}
type LabelSlot [Empty, Holds(NestedLabel), Rows(Array<TextLabel, 2>)]

fn nested_label_total(nested: NestedLabel, early: Bool) -> u32 {
    if early { return 1; }
    nested.label.number + nested.label.text.len() + nested.extra
}

fn label_slot_total(slot: LabelSlot) -> u32 {
    match slot {
        LabelSlot::Holds(nested) => nested.label.text.len() + nested.extra,
        LabelSlot::Rows(rows) => label_pair_total(rows, false),
        LabelSlot::Empty => 0,
    }
}

// A String-owning struct moves into a field of another struct, into an enum
// payload, or into an array held by either. The owner then releases the inner
// Strings once, on normal and early exits. `match` of a whole local enum
// binds the payload struct, which is read through its fields. An array moves
// into a payload from a named local, not from a literal.
fn nested_string_owners() -> Bool {
    let first_heap := "é".concat("!");
    let first := TextLabel { number: 9, text: first_heap };
    let nested := NestedLabel { label: first, extra: 1 };
    let spare_heap := "é".concat("!");
    let spare_label := TextLabel { number: 1, text: spare_heap };
    let spare := NestedLabel { label: spare_label, extra: 2 };
    let held_heap := "é".concat("!");
    let held_label := TextLabel { number: 2, text: held_heap };
    let held := NestedLabel { label: held_label, extra: 3 };
    let slot := LabelSlot::Holds(held);
    let row_heap := "é".concat("!");
    let row_first := TextLabel { number: 4, text: row_heap };
    let row_second := TextLabel { number: 5, text: "ab" };
    let row_pair := [row_first, row_second];
    let rows := LabelSlot::Rows(row_pair);
    nested_label_total(nested, false) == 13 && nested_label_total(spare, true) == 1
        && label_slot_total(slot) == 6 && label_slot_total(rows) == 14
}

fn owned_string_struct_result() -> Bool {
    let made := make_label(4);
    let unused := make_label(1);
    made.number == 4 && made.text.len() == 3 && label_total(made, false) == 7
}

type EditableLabel {
    note: string,
    text: string,
}

fn append_question(text: borrow string) -> string {
    let result := text.concat("?");
    result
}

// A new local struct can take a direct concat or internal String call
// result. Initializers run in source order. A temporary owner is released
// on an early exit from a later initializer. After construction the struct
// owns the bytes and releases them at lexical exit.
fn temporary_string_fields() -> Bool {
    let prefix := "é";
    var order: u32 = 0;
    let label := TextLabel {
        text: prefix.concat({ order = 1; "!" }),
        number: { order = order * 10 + 2; order },
    };
    let called := EditableLabel {
        note: append_question(prefix.borrow()),
        text: "",
    };
    label.number == 12 && byte_is(label.text.byte_at(2), 33)
        && byte_is(called.note.byte_at(2), 63)
}

fn inspect_text_label(label: borrow TextLabel) -> Bool {
    label.number == 9 && byte_length(label.text.borrow()) == 3
        && byte_is(label.text.byte_at(2), 33)
}

fn inspect_shared_text_label(label: share TextLabel) -> Bool {
    label.number == 9 && byte_length(label.text.borrow()) == 3
        && byte_is(label.text.byte_at(2), 33)
}

// Pass an explicit borrow or share of a named owner to a direct internal call.
// The callee reads fields through either parameter. A share is exclusive for
// the call, while the caller still owns the struct and can move it afterwards.
// Whole references cannot be saved in another binding or forwarded.
fn borrow_string_struct() -> Bool {
    let prefix := "é";
    var label := TextLabel { text: prefix.concat("!"), number: 9 };
    if !inspect_text_label(label.borrow()) || !inspect_shared_text_label(label.share()) {
        return false;
    }
    let moved := label;
    inspect_text_label(moved.borrow()) && moved.text.len() == 3
}

// Direct String field assignment on a var local consumes a named String
// or stages a literal, concat, or direct internal String call. The RHS can
// borrow the old field. The write releases the old allocation after the RHS
// finishes, and a borrow of a different field can stay live.
fn replace_local_string_field() -> Bool {
    var label := EditableLabel { note: "keep", text: "" };
    let note := label.note.borrow();
    let replacement := "é";
    label.text = replacement;
    label.text = label.text.concat("!");
    if !byte_is(label.text.byte_at(2), 33) { return false; }
    label.text = append_question(label.text.borrow());
    if !byte_is(label.text.byte_at(3), 63) { return false; }
    label.text = "";
    note.len() == 4 && label.text.len() == 0
}

// An annotation selects an empty List. push appends to a whole var local.
// Moving into a new binding transfers ownership of the backing storage.
fn primitive_lists() -> Bool {
    var bytes: List<u8> = [];
    let before := bytes.len();
    let empty := !bytes.contains(42);
    bytes.push(42);
    // Bind a direct internal List result to take ownership of its block.
    let words := make_words(1000);
    // A standalone call releases an ignored List result at the statement.
    make_words(999);
    // Read a direct internal List result with len or get. The call runs
    // before the index, and the temporary is released after the read or
    // on a normal early exit from the index expression.
    let temporary_length := make_words(999).len();
    // List<u8> and List<u32> support both searches on locals, borrow and
    // share bindings, and direct internal call results. The receiver runs
    // first and stays borrowed while the value runs once, even if empty.
    let temporary_contains := make_words(1234).contains(1234);
    let borrowed_contains := list_has_word(words.borrow(), 1000);
    let missing_index := match make_words(1234).index_of(999) {
        Some(_) => false,
        None => true
    };
    let temporary_word := match make_words(1234).get(0) {
        Some(value) => value == 1234,
        None => false
    };
    // A direct borrow parameter also accepts an explicit borrow of a direct
    // List call result. The owner lives through the call and is released
    // afterward or on a normal early exit from a later argument.
    let borrowed_word := match list_word_at(make_words(2345).borrow(), 0) {
        Some(value) => value == 2345,
        None => false
    };
    // A direct owned parameter takes a direct List call result. Arguments
    // run left to right. The caller releases the temporary if a later
    // argument exits early, and the callee owns it once invoked.
    let owned_temporary_length := owned_list_length(make_words(3456));
    var moved := words;
    // An exclusive call can grow the List that the caller owns.
    append_word(moved.share(), 2000);
    // A direct call borrows the List. get copies the element out.
    let word := match list_word_at(moved.borrow(), 1) {
        Some(value) => value == 2000,
        None => false
    };
    let old_length := moved.len();
    // Replacement releases the old block after the RHS finishes.
    moved = make_words(3000);
    // A direct share parameter can replace the caller's whole List too.
    replace_words(moved.share(), 4000);
    // Stored share handles need var for a whole replacement.
    var handle := moved.share();
    handle = make_words(5000);
    // Push through the same handle updates the owner's length and storage.
    handle.push(6000);
    // Pop removes the last element and keeps the backing storage for reuse.
    let popped := match handle.pop() {
        Some(value) => value == 6000,
        None => false
    };
    let replacement := match handle.get(0) {
        Some(value) => value == 5000,
        None => false
    };
    // Clear removes every element and keeps the storage for subsequent pushes.
    handle.clear();
    let cleared := moved.len() == 0;
    moved.push(7000);
    // An owned parameter takes the whole List and releases it at scope exit.
    let final_length := owned_list_length(moved);
    before == 0 && bytes.len() == 1 && old_length == 2 && final_length == 1 && word && replacement && popped && cleared
        && temporary_length == 1 && temporary_word && borrowed_word && owned_temporary_length == 1
        && empty && temporary_contains && borrowed_contains && missing_index && bytes.contains(42)
        && byte_is(bytes.get(0), 42) && no_byte(bytes.get(1))
}

// String literals are owned UTF-8. The empty literal is also a String.
fn text() -> string {
    "café 😀"
}

// The only source type spelling is lowercase `string`. Bare `String` is
