    let text := value.concat("!");
    text // Ownership moves out before this scope ends.
}

fn add_question_mark(value: share string) {
    value.push_str("?");
}

fn combined_byte_length(first: string, second: string, extra: u32) -> u32 {
    first.len() + second.len() + extra
}

fn text_concat() -> Bool {
    let left := "café";
    let right := "😀";
    // concat borrows both inputs. The new String owns its bytes until this
