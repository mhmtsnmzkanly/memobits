// Structs with primitive fields: a constructor function, a function that
// mutates its argument through `share`, a function that reads through `borrow`,
// field reads and writes, and a public struct from another module.
use geom::Point;

type Size {
    width: i32,
    height: i32,
    square: Bool,
    scale: u8,
}

// A constructor: a struct result is an owned value.
fn make_size(width: i32, height: i32) -> Size {
    Size { scale: 2, square: true, height: height, width: width }
}

// `share` gives exclusive mutable access: the caller sees the writes.
fn grow(s: share Size, by: i32) {
    s.width += by;
    s.height += by;
}

// `borrow` is read-only; fields are read through the reference.
fn area(s: borrow Size) -> i32 {
    let bonus := if s.scale == 2 { 1 } else { 0 };
    if s.square {
        s.width * s.height + bonus
    } else {
        0
    }
}

fn main() -> i32 {
    var s := make_size(3, 4);
    grow(s.share(), 2);
    s.scale = 2;

    let p := Point { y: 5, x: 2 };
    let offset := p.x * p.y;

    // `s` is borrowed for the call and stays usable afterwards.
    area(s.borrow()) + offset
}
