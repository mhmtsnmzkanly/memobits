type TextLabel {
    number: u32,
    text: string,
}

fn add_bang(value: borrow string) -> string {
    let text := value.concat("!");
    text
}

fn add_question(value: share string) {
    value.push_str("?");
}

pub fn check() -> i32 ! Error {
    let text := "hello";
    let joined := text.concat(" world");
    let moved := text;
    var suffixed := add_bang(joined.borrow());
    add_question(suffixed.share());
    suffixed.push_str("!");
    let suffix_length := suffixed.len();
    var label := TextLabel { text: "hi", number: 1 };
    label.text = label.text.concat(" there");
    let label_moved := label;
    let label_length := label_moved.text.len();
    if moved.len() != 5 {
        return Err(Error { code: 4 });
    }
    if suffix_length != 14 {
        return Err(Error { code: 5 });
    }
    if label_length != 8 {
        return Err(Error { code: 6 });
    }
    Ok((suffix_length + label_length) as i32)
}
