fn factorial(count: i32) -> i32 {
    var result: i32 = 1;
    var step: i32 = 1;
    loop {
        if step > count { break; }
        result = result * step;
        step = step + 1;
    }
    result
}

fn sum_to(count: i32) -> i32 {
    var total: i32 = 0;
    var step: i32 = 1;
    loop {
        if step > count { break; }
        total = total + step;
        step = step + 1;
    }
    total
}

pub fn check() -> Result<i32, Error> {
    let value := factorial(5);
    let total := sum_to(10);
    if value != 120 {
        return Err(Error { code: 2 });
    }
    if total != 55 {
        return Err(Error { code: 3 });
    }
    Ok(value + total)
}
